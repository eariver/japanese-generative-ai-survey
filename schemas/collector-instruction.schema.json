{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/collector-instruction.schema.json",
  "title": "Survey Collector Instruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "instruction_id",
    "stage",
    "collector",
    "generated_at",
    "time",
    "expected_output",
    "execution",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "instruction_id": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "trend-discovery",
        "community-reaction",
        "official-source-discovery",
        "paper-discovery",
        "github-discovery",
        "other-source-discovery"
      ]
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt_id", "prompt_version", "prompt_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_window_start", "editorial_cutoff"],
      "properties": {
        "collection_window_start": { "type": "string", "format": "date-time" },
        "editorial_cutoff": { "type": "string", "format": "date-time" }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "repository_path"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "repository_path": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repository_write_authority"],
      "properties": {
        "mode": { "enum": ["manual", "agent-assisted", "manual-or-agent-assisted"] },
        "repository_write_authority": { "enum": ["none", "write-capable-runner"] }
      }
    },
    "status": { "const": "ready" },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/stage-validation-attestation-v2.schema.json",
  "title": "Survey Production Core v2 Stage Validation Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "checkpoint",
    "action_id",
    "action_spec_sha256",
    "validator",
    "validator_version",
    "validated_at",
    "required_inputs",
    "outputs",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "action_spec_sha256": {"$ref": "#/$defs/sha256"},
    "validator": {"type": "string", "minLength": 1},
    "validator_version": {"type": "string", "minLength": 1},
    "validated_at": {"type": "string", "format": "date-time"},
    "required_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "status": {"const": "PASSED"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "required": {"type": "boolean"}
      }
    }
  }
}

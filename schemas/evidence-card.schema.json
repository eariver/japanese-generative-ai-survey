{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/evidence-card.schema.json",
  "title": "Survey Evidence Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "evidence_task_id", "status", "grouping_resolution", "artifact", "temporal", "sources", "claims", "metrics", "limitations", "verification", "editorial"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^(?:[0-9]{4}-W[0-9]{2}|SP-[A-Za-z0-9][A-Za-z0-9._-]{2,63})$" },
    "evidence_task_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["VERIFIED", "PARTIAL", "REJECTED", "NEEDS_MORE"] },
    "grouping_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "split_recommended", "note"],
      "properties": {
        "accepted": { "type": "boolean" },
        "split_recommended": { "type": "boolean" },
        "note": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "artifact_type", "organization", "canonical_url"],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "artifact_type": { "enum": ["MODEL", "MODEL_UPDATE", "OPEN_WEIGHT", "API", "PRODUCT", "AGENT", "FRAMEWORK", "PAPER", "BENCHMARK", "SAFETY_EVENT", "SECURITY_EVENT", "INTEGRATION", "OTHER"] },
        "organization": { "type": ["string", "null"] },
        "canonical_url": { "type": ["string", "null"] }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_first_announced", "events", "observed_at"],
      "properties": {
        "artifact_first_announced": { "type": ["string", "null"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "event_type", "event_date", "source_published_at", "source_ids"],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "event_type": { "type": "string", "minLength": 1 },
              "event_date": { "type": ["string", "null"] },
              "source_published_at": { "type": ["string", "null"] },
              "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "source_class", "title", "published_at", "accessed_at", "role"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "source_class": { "enum": ["PRIMARY_OFFICIAL", "PRIMARY_PAPER", "PRIMARY_REPOSITORY", "SOCIAL", "SECONDARY"] },
          "title": { "type": "string", "minLength": 1 },
          "published_at": { "type": ["string", "null"] },
          "accessed_at": { "type": "string", "format": "date-time" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "evidence_class", "source_ids", "context"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "evidence_class": { "enum": ["PRIMARY_FACT", "VENDOR_CLAIM", "PROJECT_CLAIM", "AUTHOR_CLAIM", "SOCIAL_OBSERVATION", "INFERENCE"] },
          "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "context": { "type": ["string", "null"] }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "name", "value", "unit", "context", "evidence_class", "source_ids"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "unit": { "type": ["string", "null"] },
          "context": { "type": "string", "minLength": 1 },
          "evidence_class": { "enum": ["PRIMARY_FACT", "VENDOR_CLAIM", "PROJECT_CLAIM", "AUTHOR_CLAIM", "SOCIAL_OBSERVATION", "INFERENCE"] },
          "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limitation_id", "text", "evidence_class", "source_ids"],
        "properties": {
          "limitation_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "evidence_class": { "enum": ["PRIMARY_FACT", "VENDOR_CLAIM", "PROJECT_CLAIM", "AUTHOR_CLAIM", "SOCIAL_OBSERVATION", "INFERENCE"] },
          "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "unresolved_questions", "contradictions"],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "status", "finding", "source_ids"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "status": { "enum": ["VERIFIED", "UNRESOLVED", "CONTRADICTED", "NOT_APPLICABLE"] },
              "finding": { "type": "string", "minLength": 1 },
              "source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "unresolved_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contradictions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why_now_confirmed", "why_now_note", "candidate_recommendation", "rationale"],
      "properties": {
        "why_now_confirmed": { "type": "boolean" },
        "why_now_note": { "type": ["string", "null"] },
        "candidate_recommendation": { "enum": ["CANDIDATE", "HOLD", "REJECT", "INSPECT_MORE"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/pilot-bootstrap-v2.schema.json",
  "title": "Survey Production Core v2 Pilot Bootstrap Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pilots"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "pilots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pilot_id",
          "kind",
          "issue_id",
          "target_gate",
          "research_profile",
          "publication_profile",
          "expected_paths",
          "research_scope"
        ],
        "properties": {
          "pilot_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["WEEKLY", "THEMATIC"]},
          "issue_id": {"type": "string", "minLength": 1},
          "target_gate": {"enum": ["ARCHITECTURE_REVIEW"]},
          "research_profile": {"enum": ["WEEKLY", "THEMATIC"]},
          "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
          "expected_paths": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_root", "survey_root", "work_branch"],
            "properties": {
              "source_root": {"type": "string", "minLength": 1},
              "survey_root": {"type": "string", "minLength": 1},
              "work_branch": {"type": "string", "minLength": 1}
            }
          },
          "research_scope": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["temporal_mode", "expected_cutoff"],
                "properties": {
                  "temporal_mode": {"const": "ROLLING_WINDOW"},
                  "expected_cutoff": {"type": "string", "format": "date-time"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "temporal_mode",
                  "as_of_policy",
                  "planning_authority",
                  "scope_spec_path"
                ],
                "properties": {
                  "temporal_mode": {"enum": ["OPEN_HISTORY_AS_OF", "CURRENT_STATE_AS_OF"]},
                  "as_of_policy": {"const": "SET_AT_INITIALIZATION"},
                  "planning_authority": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "entry"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "entry": {"type": "string", "minLength": 1}
                    }
                  },
                  "scope_spec_path": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        }
      }
    }
  }
}

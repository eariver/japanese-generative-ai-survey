{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/special-pipeline-state.schema.json",
  "title": "Special Survey Pipeline State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "edition_kind", "lifecycle_state", "revision", "calendar", "gates", "automation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^SP-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "edition_kind": { "enum": ["RETROSPECTIVE_PERIOD", "THEMATIC"] },
    "lifecycle_state": {
      "enum": ["ISSUE_INITIALIZED", "DISCOVERY_COLLECTED", "CANDIDATES_NORMALIZED", "EVIDENCE_REVIEWED", "SELECTION_COMPLETE", "ARCHITECTURE_ESTABLISHED", "DRAFT_COMPLETE", "VALIDATED_DRAFT", "RELEASE_CANDIDATE", "FROZEN"]
    },
    "revision": { "type": "string", "minLength": 1 },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editorial_cutoff", "cutoff_timezone", "collection_window_start", "collection_window_end", "collection_anchor_at", "retrospective_as_of"],
      "properties": {
        "editorial_cutoff": { "type": "string", "format": "date-time" },
        "cutoff_timezone": { "type": "string", "minLength": 1 },
        "collection_window_start": { "type": "string", "format": "date-time" },
        "collection_window_end": { "type": "string", "format": "date-time" },
        "collection_anchor_at": { "type": ["string", "null"], "format": "date-time" },
        "retrospective_as_of": { "type": "string", "format": "date-time" },
        "frozen_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_sources_preserved", "candidate_inventory", "evidence_normalized", "candidate_selection", "issue_architecture", "article_draft", "claim_and_chronology_validation", "latex_build", "visual_review", "freeze"],
      "properties": {
        "raw_sources_preserved": { "$ref": "#/$defs/gateStatus" },
        "candidate_inventory": { "$ref": "#/$defs/gateStatus" },
        "evidence_normalized": { "$ref": "#/$defs/gateStatus" },
        "candidate_selection": { "$ref": "#/$defs/gateStatus" },
        "issue_architecture": { "$ref": "#/$defs/gateStatus" },
        "article_draft": { "$ref": "#/$defs/gateStatus" },
        "claim_and_chronology_validation": { "$ref": "#/$defs/gateStatus" },
        "latex_build": { "$ref": "#/$defs/gateStatus" },
        "visual_review": { "$ref": "#/$defs/gateStatus" },
        "freeze": { "$ref": "#/$defs/gateStatus" }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_gate_model",
        "unattended_public_release",
        "human_gate_required_for_selection",
        "human_gate_required_for_architecture",
        "human_gate_required_for_publication_preview",
        "human_gate_required_for_visual_review",
        "human_gate_required_for_freeze",
        "human_gate_required_for_public_release",
        "publication_preview_authorizes",
        "exception_gate"
      ],
      "properties": {
        "human_gate_model": { "const": "ARCHITECTURE_PUBLICATION_PREVIEW_WITH_EXCEPTION" },
        "unattended_public_release": { "const": false },
        "human_gate_required_for_selection": { "const": false },
        "human_gate_required_for_architecture": { "const": true },
        "human_gate_required_for_publication_preview": { "const": true },
        "human_gate_required_for_visual_review": { "const": false },
        "human_gate_required_for_freeze": { "const": false },
        "human_gate_required_for_public_release": { "const": false },
        "publication_preview_authorizes": {
          "type": "array",
          "prefixItems": [
            { "const": "visual_review" },
            { "const": "freeze" },
            { "const": "work_pr_merge" },
            { "const": "public_release" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "exception_gate": { "const": "ON_DEMAND" }
      }
    },
    "provenance": { "type": "object" },
    "provenance_history": { "type": "object" }
  },
  "$defs": { "gateStatus": { "enum": ["pending", "passed", "failed", "not-applicable"] } }
}

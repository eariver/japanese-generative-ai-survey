{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/operator-pending-gate-invalidation-v2.schema.json",
  "title": "Survey Production Core v2 Operator Pending Human Gate Invalidation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "gate",
    "invalidation_id",
    "sequence",
    "human_decision",
    "prior_state",
    "prior_gate_inputs",
    "invalidated_repository_commit_sha",
    "work_branch",
    "expected_work_branch_head",
    "regeneration_boundary",
    "reason",
    "operator_reference",
    "invalidated_checkpoint_authority",
    "superseded_canonical_paths",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "gate": {"enum": ["ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW"]},
    "invalidation_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "human_decision": {"const": false},
    "prior_state": {"$ref": "#/$defs/authority"},
    "prior_gate_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedAuthority"}
    },
    "invalidated_repository_commit_sha": {"$ref": "#/$defs/gitsha"},
    "work_branch": {"type": "string", "minLength": 1},
    "expected_work_branch_head": {"$ref": "#/$defs/gitsha"},
    "regeneration_boundary": {"$ref": "#/$defs/lifecycle"},
    "reason": {"type": "string", "minLength": 1},
    "operator_reference": {"type": "string", "minLength": 1},
    "invalidated_checkpoint_authority": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedCheckpointAuthority"}
    },
    "superseded_canonical_paths": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedAuthority"}
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "namedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "namedCheckpointAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "path", "sha256"],
      "properties": {
        "checkpoint": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lifecycle": {"enum": [
      "ISSUE_INITIALIZED", "DISCOVERY_COLLECTED", "CANDIDATES_NORMALIZED",
      "EVIDENCE_REVIEWED", "SELECTION_COMPLETE", "ARCHITECTURE_ESTABLISHED",
      "DRAFT_COMPLETE", "VALIDATED_DRAFT", "RELEASE_CANDIDATE", "FROZEN", "RELEASED"
    ]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/evidence-execution-package.schema.json",
  "title": "Weekly Survey Evidence Execution Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "source",
    "screening_basis",
    "prompt",
    "contracts",
    "evidence_tasks",
    "expected_outputs",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit_sha", "pipeline_state_sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pipeline_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "screening_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_set_sha256", "acceptance_path", "acceptance_sha256", "verification_queue_path", "verification_queue_sha256"],
      "properties": {
        "result_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "acceptance_path": { "type": "string", "minLength": 1 },
        "acceptance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verification_queue_path": { "type": "string", "minLength": 1 },
        "verification_queue_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "path", "sha256"],
      "properties": {
        "prompt_id": { "const": "primary-source-verification-v0.1" },
        "path": { "const": "contract/primary-source-verification-v0.1.md" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_run", "evidence_card"],
      "properties": {
        "evidence_run": { "$ref": "#/$defs/file_contract" },
        "evidence_card": { "$ref": "#/$defs/file_contract" }
      }
    },
    "evidence_tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "index_path", "index_sha256", "task_count", "tasks"],
      "properties": {
        "manifest_path": { "const": "input/evidence-task-manifest.json" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "index_path": { "const": "input/evidence-task-index.jsonl" },
        "index_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "task_count": { "type": "integer", "minimum": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_task_id", "path", "sha256", "bytes"],
            "properties": {
              "evidence_task_id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^input/tasks/.+\\.json$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "expected_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_result_per_task", "schema_version", "naming"],
      "properties": {
        "one_result_per_task": { "const": true },
        "schema_version": { "const": "1.0" },
        "naming": { "const": "results/<input task filename>" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "file_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

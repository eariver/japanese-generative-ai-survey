{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/evidence-task.schema.json",
  "title": "Survey Evidence Verification Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "evidence_task_id", "task_type", "grouping", "screening_ids", "screening_decisions", "source_types", "locators", "topic_lanes", "why_now", "verification_targets", "status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^(?:[0-9]{4}-W[0-9]{2}|SP-[A-Za-z0-9][A-Za-z0-9._-]{2,63})$" },
    "evidence_task_id": { "type": "string", "pattern": "^evidence:(?:[0-9]{4}-W[0-9]{2}|SP-[A-Za-z0-9][A-Za-z0-9._-]{2,63}):[a-z0-9-]{8,64}$" },
    "task_type": { "enum": ["VERIFY_ITEM", "VERIFY_SERIES", "INSPECT_INDEX"] },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "duplicate_group", "requires_confirmation"],
      "properties": {
        "basis": { "enum": ["single-screening-item", "llm-duplicate-group"] },
        "duplicate_group": { "type": ["string", "null"] },
        "requires_confirmation": { "type": "boolean" }
      }
    },
    "screening_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "screening_decisions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["KEEP", "MAYBE", "INSPECT"] } },
    "source_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["paper", "github-release", "official-feed-item", "official-index-snapshot"] } },
    "locators": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "topic_lanes": { "type": "array", "uniqueItems": true, "items": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"] } },
    "why_now": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "verification_targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "PENDING_VERIFICATION" }
  }
}

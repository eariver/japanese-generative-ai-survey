{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/screening-v2-run-package.schema.json",
  "title": "Survey Production Core v2 Screening Run Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "basis", "prompt", "result_contract", "input", "expected_outputs", "rules"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_path", "profile_sha256", "state_path", "state_sha256", "discovery_path", "discovery_sha256"],
      "properties": {
        "profile_path": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "state_path": {"type": "string", "minLength": 1},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "discovery_path": {"type": "string", "minLength": 1},
        "discovery_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "config/prompts/source-screening-v2.md"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "schemas/screening-v2-batch-result.schema.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "batch_policy", "batches"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "batch_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_records", "max_json_chars"],
          "properties": {
            "max_records": {"type": "integer", "minimum": 1},
            "max_json_chars": {"type": "integer", "minimum": 1}
          }
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["batch_id", "path", "record_count", "sha256"],
            "properties": {
              "batch_id": {"type": "string", "pattern": "^batch-[0-9]{3}$"},
              "path": {"type": "string", "pattern": "^input/batches/batch-[0-9]{3}\\.jsonl$"},
              "record_count": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "expected_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_pattern", "one_result_per_batch", "schema_version"],
      "properties": {
        "file_pattern": {"const": "results/batch-###.json"},
        "one_result_per_batch": {"const": true},
        "schema_version": {"const": "2.0-rc1"}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

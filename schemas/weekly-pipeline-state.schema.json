{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/weekly-pipeline-state.schema.json",
  "title": "Weekly Survey Pipeline State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "lifecycle_state",
    "revision",
    "calendar",
    "gates",
    "automation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "lifecycle_state": {
      "enum": [
        "ISSUE_INITIALIZED",
        "DISCOVERY_COLLECTED",
        "CANDIDATES_NORMALIZED",
        "EVIDENCE_REVIEWED",
        "SELECTION_COMPLETE",
        "ARCHITECTURE_ESTABLISHED",
        "DRAFT_COMPLETE",
        "VALIDATED_DRAFT",
        "RELEASE_CANDIDATE",
        "FROZEN"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editorial_cutoff",
        "cutoff_timezone",
        "collection_window_start",
        "collection_anchor_at"
      ],
      "properties": {
        "editorial_window_start": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Canonical issue membership start for W33 and later. Legacy frozen issues may omit it."
        },
        "editorial_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "cutoff_timezone": {
          "const": "America/New_York"
        },
        "collection_window_start": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Compatibility field. For W33 and later this is the canonical editorial-window start in issue state; per-run segment bounds live in the generated plan."
        },
        "intake_split_boundary": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Deterministic boundary between front and back intake segments."
        },
        "collection_anchor_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Accepted observation anchor for provenance continuity only; it does not define W33+ issue membership."
        },
        "frozen_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_sources_preserved",
        "candidate_inventory",
        "evidence_normalized",
        "candidate_selection",
        "issue_architecture",
        "article_draft",
        "claim_and_chronology_validation",
        "latex_build",
        "visual_review",
        "freeze"
      ],
      "properties": {
        "raw_sources_preserved": { "$ref": "#/$defs/gateStatus" },
        "candidate_inventory": { "$ref": "#/$defs/gateStatus" },
        "evidence_normalized": { "$ref": "#/$defs/gateStatus" },
        "candidate_selection": { "$ref": "#/$defs/gateStatus" },
        "issue_architecture": { "$ref": "#/$defs/gateStatus" },
        "article_draft": { "$ref": "#/$defs/gateStatus" },
        "claim_and_chronology_validation": { "$ref": "#/$defs/gateStatus" },
        "latex_build": { "$ref": "#/$defs/gateStatus" },
        "visual_review": { "$ref": "#/$defs/gateStatus" },
        "freeze": { "$ref": "#/$defs/gateStatus" }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unattended_public_release",
        "human_gate_required_for_selection",
        "human_gate_required_for_freeze"
      ],
      "properties": {
        "unattended_public_release": { "const": false },
        "human_gate_required_for_selection": { "const": true },
        "human_gate_required_for_freeze": { "const": true }
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "gateStatus": {
      "enum": ["pending", "passed", "failed", "not-applicable"]
    }
  }
}

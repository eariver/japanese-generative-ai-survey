{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/evidence-v2-run-package.schema.json",
  "title": "Survey Production Core v2 Evidence Run Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "basis", "prompt", "contracts", "tasks", "expected_outputs", "rules"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_path", "profile_sha256", "state_path", "state_sha256", "discovery_path", "discovery_sha256", "screening_acceptance_path", "screening_acceptance_sha256"],
      "properties": {
        "profile_path": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "state_path": {"type": "string", "minLength": 1},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "discovery_path": {"type": "string", "minLength": 1},
        "discovery_sha256": {"$ref": "#/$defs/sha256"},
        "screening_acceptance_path": {"type": "string", "minLength": 1},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "config/prompts/evidence-verification-v2.md"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_package", "task", "card"],
      "properties": {
        "run_package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-v2-run-package.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-v2-task.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "schemas/evidence-v2-card.schema.json"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_task_id", "path", "sha256", "discovery_ids"],
        "properties": {
          "evidence_task_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^tasks/task-[0-9a-f]{20}\\.json$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "discovery_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "expected_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_result_per_task", "filename_rule"],
      "properties": {
        "one_result_per_task": {"const": true},
        "filename_rule": {"const": "same-basename-as-task"}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/collector-run.schema.json",
  "title": "Survey Collector Run Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "run_id",
    "stage",
    "collector",
    "time",
    "outputs",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-W[0-9]{2}|SP-[A-Za-z0-9][A-Za-z0-9._-]{2,63})$"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "trend-discovery",
        "community-reaction",
        "official-source-discovery",
        "paper-discovery",
        "github-discovery",
        "other-source-discovery"
      ]
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_id": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "prompt_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "editorial_cutoff"],
      "properties": {
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "observed_at": { "type": "string", "format": "date-time" },
        "collection_window_start": { "type": ["string", "null"], "format": "date-time" },
        "collection_window_end": { "type": ["string", "null"], "format": "date-time" },
        "editorial_cutoff": { "type": "string", "format": "date-time" }
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "tool_access": { "type": "array", "items": { "type": "string" }, "default": [] },
    "status": { "enum": ["success", "partial", "failed", "insufficient-evidence"] },
    "notes": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}

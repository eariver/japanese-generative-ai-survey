{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/candidate-selection-decision.schema.json",
  "title": "Weekly Survey Candidate Selection Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "selection_version", "status", "basis", "approval", "assignments", "rules"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "selection_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["PENDING_APPROVAL", "APPROVED"] },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_path", "matrix_sha256"],
      "properties": {
        "matrix_path": { "type": "string", "minLength": 1 },
        "matrix_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "approval_reference"],
      "properties": {
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "approval_reference": { "type": ["string", "null"] }
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_task_id", "title", "role", "rationale"],
        "properties": {
          "evidence_task_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "role": {
            "enum": [
              "UNASSIGNED",
              "FEATURE_CORE",
              "SECTION_CORE",
              "PAPER_WATCH",
              "SUPPORTING_EVIDENCE",
              "LATE_BREAKING",
              "CHRONOLOGY",
              "WATCHLIST",
              "HOLD_OUT",
              "EXCLUDE"
            ]
          },
          "rationale": { "type": ["string", "null"] }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

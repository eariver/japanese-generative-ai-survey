{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/article-draft-result.schema.json",
  "title": "Survey Evidence-Linked Article Draft Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "package_id",
    "draft_version",
    "status",
    "basis",
    "runner",
    "headline",
    "deck",
    "deck_attribution_mode",
    "deck_evidence_refs",
    "blocks",
    "must_cover_coverage",
    "boundary_coverage",
    "late_breaking_acknowledged"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^(?:[0-9]{4}-W[0-9]{2}|SP-[A-Z0-9][A-Z0-9-]{2,63})$" },
    "package_id": { "type": "string", "minLength": 1 },
    "draft_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["DRAFT", "REVISED"] },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_package_sha256", "prompt_id", "prompt_sha256"],
      "properties": {
        "draft_package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prompt_id": { "const": "article-drafting-v0.1" },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "invocation", "generated_at"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "invocation": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "run_reference": { "type": ["string", "null"] }
      }
    },
    "headline": { "type": "string", "minLength": 1 },
    "deck": { "type": "string", "minLength": 1 },
    "deck_attribution_mode": { "enum": ["NONE", "FACTUAL", "ATTRIBUTED", "SOCIAL", "INFERENCE", "MIXED"] },
    "deck_evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "block_type", "text", "attribution_mode", "evidence_refs"],
        "properties": {
          "block_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "block_type": {
            "enum": ["HEADING", "PARAGRAPH", "BULLET_LIST", "TABLE", "CLAIM_BOUNDARY", "COMMUNITY_NOTE", "LATE_BREAKING_NOTE"]
          },
          "text": { "type": "string", "minLength": 1 },
          "attribution_mode": { "enum": ["NONE", "FACTUAL", "ATTRIBUTED", "SOCIAL", "INFERENCE", "MIXED"] },
          "evidence_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidenceRef" }
          }
        }
      }
    },
    "must_cover_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage" }
    },
    "boundary_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage" }
    },
    "late_breaking_acknowledged": { "type": "boolean" }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_task_id", "kind", "evidence_id"],
      "properties": {
        "evidence_task_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["EVENT", "CLAIM", "METRIC", "LIMITATION"] },
        "evidence_id": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "block_ids"],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "block_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

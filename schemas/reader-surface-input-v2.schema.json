{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reader-surface-input-v2.schema.json",
  "title": "Survey Production Core v2 Canonical Pre-TeX Structured Reader Surface Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "publication_profile",
    "closing_synthesis",
    "final_summary_paragraphs",
    "packages"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
    "headline": {"type": "string"},
    "deck": {"type": "string"},
    "closing_synthesis": {"type": "string", "minLength": 1},
    "final_summary_paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "headline", "deck", "blocks"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "headline": {"type": "string"},
          "deck": {"type": "string"},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block_id", "text"],
              "properties": {
                "block_id": {"type": "string", "minLength": 1},
                "text": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}

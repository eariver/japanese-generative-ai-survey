{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/stage-handoff-request-v2.schema.json",
  "title": "Survey Production Core v2 Stage Handoff Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "lifecycle_state", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "lifecycle_state": {
      "enum": [
        "ISSUE_INITIALIZED",
        "DISCOVERY_COLLECTED",
        "CANDIDATES_NORMALIZED",
        "EVIDENCE_REVIEWED",
        "SELECTION_COMPLETE",
        "ARCHITECTURE_ESTABLISHED",
        "DRAFT_COMPLETE",
        "VALIDATED_DRAFT",
        "RELEASE_CANDIDATE",
        "FROZEN"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedPath"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedPath"}
    }
  },
  "$defs": {
    "namedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    }
  }
}

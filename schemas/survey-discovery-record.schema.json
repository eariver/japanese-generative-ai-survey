{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/survey-discovery-record.schema.json",
  "title": "Survey Production Core v2 Discovery Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "discovery_id", "provenance", "source"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "discovery_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "research_pass", "parent_refs", "obligation_ids", "reason"],
      "properties": {
        "origin": {
          "enum": [
            "BASE",
            "CARRY_OVER",
            "REFERENCE_EXPANSION",
            "SUCCESSOR_EXPANSION",
            "PARALLEL_EXPANSION",
            "COMPETING_EXPANSION",
            "BRIDGE_EXPANSION",
            "GAP_FILL"
          ]
        },
        "research_pass": {"type": "integer", "minimum": 0},
        "parent_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "obligation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "collector_id",
        "collector_run_id",
        "observed_at",
        "title",
        "locator",
        "raw_paths",
        "published_at",
        "summary_text",
        "metadata"
      ],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "collector_id": {"type": "string", "minLength": 1},
        "collector_run_id": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string"},
        "locator": {"type": "string", "minLength": 1},
        "raw_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "published_at": {"type": ["string", "null"]},
        "summary_text": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    }
  }
}

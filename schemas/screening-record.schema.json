{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/screening-record.schema.json",
  "title": "Survey Source Screening Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "screening_id", "source_type", "collector_id", "collector_run_id", "observed_at", "title", "locator", "raw_paths", "published_at", "summary_text", "metadata"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^(?:[0-9]{4}-W[0-9]{2}|SP-[A-Za-z0-9][A-Za-z0-9._-]{2,63})$" },
    "screening_id": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["paper", "github-release", "official-feed-item", "official-index-snapshot"] },
    "collector_id": { "type": "string", "minLength": 1 },
    "collector_run_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "title": { "type": "string" },
    "locator": { "type": "string", "minLength": 1 },
    "raw_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "published_at": { "type": ["string", "null"] },
    "summary_text": { "type": ["string", "null"] },
    "metadata": { "type": "object" }
  }
}

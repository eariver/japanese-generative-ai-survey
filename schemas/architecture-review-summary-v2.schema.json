{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/architecture-review-summary-v2.schema.json",
  "title": "Survey Production Core v2 Architecture Review Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "basis", "readiness", "discovery", "research_expansion", "screening", "evidence", "materiality", "selection", "completeness", "major_material_destinations", "residual_limitations", "architecture"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_sha256", "production_profile_sha256", "profile_completeness_sha256", "materiality_ledger_sha256", "candidate_matrix_sha256", "candidate_selection_sha256"],
      "properties": {
        "architecture_sha256": {"$ref": "#/$defs/sha256"},
        "production_profile_sha256": {"$ref": "#/$defs/sha256"},
        "profile_completeness_sha256": {"$ref": "#/$defs/sha256"},
        "materiality_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors"],
      "properties": {
        "status": {"enum": ["READY_FOR_ARCHITECTURE_REVIEW", "BLOCKED"]},
        "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "discovery": {"$ref": "#/$defs/count_summary"},
    "research_expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_research_pass", "pass_counts", "parent_link_count", "obligation_link_count", "unique_obligation_count", "root_discovery_count", "expanded_discovery_count"],
      "properties": {
        "max_research_pass": {"type": "integer", "minimum": 0},
        "pass_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "parent_link_count": {"type": "integer", "minimum": 0},
        "obligation_link_count": {"type": "integer", "minimum": 0},
        "unique_obligation_count": {"type": "integer", "minimum": 0},
        "root_discovery_count": {"type": "integer", "minimum": 0},
        "expanded_discovery_count": {"type": "integer", "minimum": 0}
      }
    },
    "screening": {"$ref": "#/$defs/count_summary"},
    "evidence": {"$ref": "#/$defs/count_summary"},
    "materiality": {"$ref": "#/$defs/count_summary"},
    "selection": {"$ref": "#/$defs/count_summary"},
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_status", "obligation_counts"],
      "properties": {
        "overall_status": {"enum": ["READY", "LIMITED", "INCOMPLETE"]},
        "obligation_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "major_material_destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "title", "materiality", "selection_disposition", "destination_kind", "destinations", "exception_reason"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "materiality": {"enum": ["MATERIAL", "CONTEXT"]},
          "selection_disposition": {"enum": ["SELECTED", "HOLD", "REJECT", "INSPECT"]},
          "destination_kind": {"enum": ["PRIMARY", "SUPPORTING", "EXCEPTION", "NOT_SELECTED"]},
          "destinations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "exception_reason": {"type": ["string", "null"]}
        }
      }
    },
    "residual_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "editorial_thesis", "package_count", "packages", "page_plan"],
      "properties": {
        "status": {"enum": ["PROPOSED", "APPROVED"]},
        "editorial_thesis": {"type": "string", "minLength": 1},
        "package_count": {"type": "integer", "minimum": 1},
        "packages": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "page_plan": {"type": "object"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "counts"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    }
  }
}

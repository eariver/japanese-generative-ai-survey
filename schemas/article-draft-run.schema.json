{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/article-draft-run.schema.json",
  "title": "Weekly Survey Article Draft Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "package_id",
    "drafting_package_sha256",
    "prompt_id",
    "prompt_sha256",
    "runner",
    "draft"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "package_id": { "type": "string", "minLength": 1 },
    "drafting_package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prompt_id": { "const": "article-drafting-v0.1" },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "invocation", "generated_at", "run_reference"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "invocation": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "run_reference": { "type": ["string", "null"] }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "title",
        "dek",
        "latex_body",
        "evidence_task_ids_used",
        "claim_ledger",
        "must_cover_coverage",
        "boundary_coverage",
        "open_questions"
      ],
      "properties": {
        "status": { "enum": ["DRAFTED", "NEEDS_EVIDENCE", "BLOCKED"] },
        "title": { "type": ["string", "null"] },
        "dek": { "type": ["string", "null"] },
        "latex_body": { "type": ["string", "null"] },
        "evidence_task_ids_used": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["draft_claim_id", "text", "evidence_class", "assertion_mode", "evidence_refs", "citation_keys", "boundary_note"],
            "properties": {
              "draft_claim_id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "evidence_class": {
                "enum": ["PRIMARY_FACT", "VENDOR_CLAIM", "PROJECT_CLAIM", "AUTHOR_CLAIM", "SOCIAL_OBSERVATION", "INFERENCE"]
              },
              "assertion_mode": { "enum": ["FACT", "ATTRIBUTED_CLAIM", "INFERENCE"] },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_task_id", "claim_ids", "metric_ids", "limitation_ids", "event_indices", "source_ids"],
                  "properties": {
                    "evidence_task_id": { "type": "string", "minLength": 1 },
                    "claim_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "metric_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "limitation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "event_indices": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
                    "source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              },
              "citation_keys": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "boundary_note": { "type": ["string", "null"] }
            }
          }
        },
        "must_cover_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "status", "note"],
            "properties": {
              "requirement": { "type": "string", "minLength": 1 },
              "status": { "enum": ["COVERED", "BLOCKED"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "boundary_coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["boundary", "status", "note"],
            "properties": {
              "boundary": { "type": "string", "minLength": 1 },
              "status": { "enum": ["PRESERVED", "NOT_APPLICABLE", "BLOCKED"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/quality-regression-bundle-v2.schema.json",
  "title": "Survey Production Core v2 Coupled Quality Regression Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "source", "pdf", "checks", "status", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/artifact"},
    "pdf": {"$ref": "#/$defs/artifact"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "evidence"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"const": "PASS"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

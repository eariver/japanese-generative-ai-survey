{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/quality-regression-bundle-v2.schema.json",
  "title": "Survey Production Core v2 Quality Review Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "production_profile",
    "research_profile",
    "publication_profile",
    "source",
    "pdf",
    "checks",
    "status",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "production_profile": {"$ref": "#/$defs/artifact"},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "publication_profile": {"enum": ["WEEKLY_MAGAZINE", "LONGFORM_SPECIAL"]},
    "source": {"$ref": "#/$defs/artifact"},
    "pdf": {"$ref": "#/$defs/pdfAuthority"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "kind", "status", "executor", "evidence", "recorded_at", "result"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["DETERMINISTIC", "AGENT_SEMANTIC", "AGENT_VISUAL"]},
          "status": {"const": "PASS"},
          "executor": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recorded_at": {"type": "string", "format": "date-time"},
          "result": {"$ref": "#/$defs/nullableArtifact"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "DETERMINISTIC"}}},
            "then": {"properties": {"result": {"$ref": "#/$defs/artifact"}}}
          },
          {
            "if": {"properties": {"kind": {"enum": ["AGENT_SEMANTIC", "AGENT_VISUAL"]}}},
            "then": {"properties": {"result": {"type": "null"}}}
          }
        ]
      }
    },
    "status": {"const": "PASS"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableArtifact": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "actionsArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow_run_id", "artifact_id", "artifact_name", "artifact_digest"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_name": {"type": "string", "minLength": 1},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "pdfAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "path", "sha256", "byte_count", "actions_artifact"],
      "properties": {
        "storage": {"enum": ["REPOSITORY_FILE", "GITHUB_ACTIONS_ARTIFACT"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1},
        "actions_artifact": {"oneOf": [{"$ref": "#/$defs/actionsArtifact"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"storage": {"const": "REPOSITORY_FILE"}}}, "then": {"properties": {"actions_artifact": {"type": "null"}}}},
        {"if": {"properties": {"storage": {"const": "GITHUB_ACTIONS_ARTIFACT"}}}, "then": {"properties": {"actions_artifact": {"$ref": "#/$defs/actionsArtifact"}}}}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/materiality-ledger.schema.json",
  "title": "Survey Production Core v2 Materiality Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "basis", "rows"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_profile_sha256", "discovery_sha256", "screening_acceptance_sha256", "evidence_acceptance_sha256", "edition_views_acceptance_sha256", "evidence_set_sha256", "edition_view_set_sha256"],
      "properties": {
        "production_profile_sha256": {"$ref": "#/$defs/sha256"},
        "discovery_sha256": {"$ref": "#/$defs/sha256"},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "edition_views_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_set_sha256": {"$ref": "#/$defs/sha256"},
        "edition_view_set_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discovery_id", "origin", "screening_decision", "downstream_disposition", "evidence_task_ids", "evidence_view_statuses", "duplicate_group", "rationale"],
        "properties": {
          "discovery_id": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "minLength": 1},
          "screening_decision": {"enum": ["KEEP", "MAYBE", "DROP", "INSPECT"]},
          "downstream_disposition": {"enum": ["MATERIAL", "CONTEXT", "NON_MATERIAL", "HOLD", "DUPLICATE", "EXCLUDED"]},
          "evidence_task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_view_statuses": {"type": "array", "uniqueItems": true, "items": {"enum": ["MATERIAL", "CONTEXT", "NON_MATERIAL", "HOLD"]}},
          "duplicate_group": {"type": ["string", "null"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

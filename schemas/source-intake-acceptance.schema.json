{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/source-intake-acceptance.schema.json",
  "title": "Weekly Survey Reviewed Source Intake Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "status",
    "source_actions",
    "source_intake_report_sha256",
    "collector_run_count",
    "files",
    "raw_file_count",
    "derived_screening_committed",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "status": { "const": "ACCEPTED" },
    "source_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_run_id", "artifact_id", "artifact_name", "artifact_digest", "review_reference"],
      "properties": {
        "workflow_run_id": { "type": "integer", "minimum": 1 },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "artifact_name": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "review_reference": { "type": "string", "minLength": 1 }
      }
    },
    "source_intake_report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "collector_run_count": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "kind"],
        "properties": {
          "path": { "type": "string", "pattern": "^sources/[0-9]{4}-W[0-9]{2}/collectors/" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["RAW", "COLLECTOR_RUN", "SUMMARY"] }
        }
      }
    },
    "raw_file_count": { "type": "integer", "minimum": 1 },
    "derived_screening_committed": { "const": false },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/candidate-matrix-v2.schema.json",
  "title": "Survey Production Core v2 Candidate Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "basis", "rows", "summary"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_profile_sha256", "profile_completeness_sha256", "materiality_ledger_sha256", "evidence_acceptance_sha256", "edition_views_acceptance_sha256"],
      "properties": {
        "production_profile_sha256": {"$ref": "#/$defs/sha256"},
        "profile_completeness_sha256": {"$ref": "#/$defs/sha256"},
        "materiality_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "edition_views_acceptance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "evidence_task_id", "discovery_ids", "evidence_sha256", "edition_view_sha256", "title", "artifact_type", "evidence_status", "materiality", "scope_dimensions", "comparison", "remaining_boundaries", "profile_extensions"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "evidence_task_id": {"type": "string", "minLength": 1},
          "discovery_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_sha256": {"$ref": "#/$defs/sha256"},
          "edition_view_sha256": {"$ref": "#/$defs/sha256"},
          "title": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "evidence_status": {"enum": ["VERIFIED", "PARTIAL", "REJECTED", "NEEDS_MORE"]},
          "materiality": {"enum": ["MATERIAL", "CONTEXT", "NON_MATERIAL", "HOLD"]},
          "scope_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "comparison": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_count", "claim_count", "metric_count", "limitation_count", "unresolved_question_count", "contradiction_count", "entity_count"],
            "properties": {
              "source_count": {"type": "integer", "minimum": 0},
              "claim_count": {"type": "integer", "minimum": 0},
              "metric_count": {"type": "integer", "minimum": 0},
              "limitation_count": {"type": "integer", "minimum": 0},
              "unresolved_question_count": {"type": "integer", "minimum": 0},
              "contradiction_count": {"type": "integer", "minimum": 0},
              "entity_count": {"type": "integer", "minimum": 1}
            }
          },
          "remaining_boundaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "profile_extensions": {"type": "object"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "materiality_counts", "evidence_status_counts"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "materiality_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "evidence_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

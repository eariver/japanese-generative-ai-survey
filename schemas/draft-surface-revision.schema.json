{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/draft-surface-revision.schema.json",
  "title": "Survey Production Core v2 Reviewed Draft Surface Revision",
  "description": "State-bound immutable authority for a Sol/editorial-reviewed Draft revision adopted after the normal Draft checkpoint. Historical Stage Checkpoints are never rewritten; this record supersedes named Draft-result/synthesis rows only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "reason_class",
    "reason",
    "lifecycle",
    "prior_checkpoint",
    "superseded_artifacts",
    "preserved_artifacts",
    "review",
    "validation",
    "core",
    "executor",
    "recorded_at",
    "supersedes",
    "establishment"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "reason_class": {"const": "REVIEWED_DRAFT_REVISION"},
    "reason": {"type": "string", "minLength": 1},
    "lifecycle": {"const": "DRAFT_COMPLETE"},
    "prior_checkpoint": {"$ref": "#/$defs/authority"},
    "superseded_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/superseded_artifact"}
    },
    "preserved_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/preserved_artifact"}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "decision", "reviewed_by"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "decision": {"const": "PASS"},
        "reviewed_by": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_results",
        "synthesis_input",
        "synthesis_result",
        "architecture",
        "architecture_approval",
        "summary"
      ],
      "properties": {
        "draft_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package_id", "path", "sha256"],
            "properties": {
              "package_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "synthesis_input": {"$ref": "#/$defs/authority"},
        "synthesis_result": {"$ref": "#/$defs/authority"},
        "architecture": {"$ref": "#/$defs/authority"},
        "architecture_approval": {"$ref": "#/$defs/authority"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "core": {"$ref": "#/$defs/core"},
    "executor": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "supersedes": {
      "description": "Exact authority reference to the prior revision record this round supersedes, or null for the first round. The referenced file must remain immutable on disk.",
      "oneOf": [{"$ref": "#/$defs/authority"}, {"type": "null"}]
    },
    "establishment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_sha256",
        "lifecycle",
        "architecture_review",
        "publication_preview",
        "validation",
        "freeze",
        "release",
        "implementation_commit_sha",
        "recorded_at"
      ],
      "properties": {
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle": {"const": "DRAFT_COMPLETE"},
        "architecture_review": {"const": "approved"},
        "publication_preview": {"const": "pending"},
        "validation": {"const": "pending"},
        "freeze": {"const": "pending"},
        "release": {"const": "pending"},
        "implementation_commit_sha": {"$ref": "#/$defs/gitsha"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "superseded_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "prior_sha256", "new_sha256", "byte_count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "prior_sha256": {"$ref": "#/$defs/sha256"},
        "new_sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "preserved_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "implementation_commit_sha"],
      "properties": {
        "contract": {"type": "object"},
        "implementation_commit_sha": {"$ref": "#/$defs/gitsha"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}

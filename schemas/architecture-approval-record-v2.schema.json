{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/architecture-approval-record-v2.schema.json",
  "title": "Survey Production Core v2 Architecture Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "issue_id", "gate", "decision", "architecture_sha256", "architecture_review_summary_sha256", "architecture_review_attention_sha256", "reviewed_by", "reviewed_at", "review_reference"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "approval_id": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "gate": {"const": "ARCHITECTURE_REVIEW"},
    "decision": {"const": "APPROVED"},
    "architecture_sha256": {"$ref": "#/$defs/sha256"},
    "architecture_review_summary_sha256": {"$ref": "#/$defs/sha256"},
    "architecture_review_attention_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_reference": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/weekly-release-manifest.schema.json",
  "title": "Weekly Survey Frozen Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "revision",
    "status",
    "source_commit",
    "release_tag",
    "release_title",
    "asset_name",
    "expected_pdf_sha256",
    "page_count",
    "survey_root",
    "freeze_record"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "status": { "const": "frozen" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^weekly/[0-9]{4}-W[0-9]{2}/v[0-9]+\\.[0-9]+$"
    },
    "release_title": { "type": "string", "minLength": 1 },
    "asset_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.pdf$"
    },
    "expected_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_count": { "type": "integer", "minimum": 1 },
    "survey_root": { "type": "string", "minLength": 1 },
    "freeze_record": { "type": "string", "minLength": 1 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string" },
        "texlive": { "type": "string" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}

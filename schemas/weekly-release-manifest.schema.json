{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/weekly-release-manifest.schema.json",
  "title": "Weekly Survey Frozen Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "status",
    "source_commit",
    "release_tag",
    "release_title",
    "asset_name",
    "expected_pdf_sha256",
    "page_count",
    "survey_root",
    "freeze_record",
    "pdf_source"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "release_identity_mode": { "const": "ISSUE_ONLY" },
    "revision": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "status": { "const": "frozen" },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tag": { "type": "string", "minLength": 1 },
    "release_title": { "type": "string", "minLength": 1 },
    "asset_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.pdf$"
    },
    "expected_pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page_count": { "type": "integer", "minimum": 1 },
    "survey_root": { "type": "string", "minLength": 1 },
    "freeze_record": { "type": "string", "minLength": 1 },
    "public_release_authorized": { "type": "boolean" },
    "release_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "authorized_at", "approval_reference"],
      "properties": {
        "mode": { "const": "FREEZE_APPROVAL" },
        "authorized_at": { "type": "string", "format": "date-time" },
        "approval_reference": { "type": "string", "minLength": 1 }
      }
    },
    "pdf_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["actions-artifact", "rebuild"] },
        "workflow_run_id": { "type": "integer", "minimum": 1 },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "artifact_name": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string" },
        "texlive": { "type": "string" },
        "source_date_epoch_policy": { "type": ["string", "null"] }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": ["release_identity_mode", "public_release_authorized", "release_authorization"],
          "not": { "required": ["revision"] },
          "properties": {
            "release_identity_mode": { "const": "ISSUE_ONLY" },
            "release_tag": { "pattern": "^weekly/[0-9]{4}-W[0-9]{2}$" },
            "public_release_authorized": { "const": true }
          }
        },
        {
          "required": ["revision"],
          "not": { "required": ["release_identity_mode"] },
          "properties": {
            "release_tag": { "pattern": "^weekly/[0-9]{4}-W[0-9]{2}/v[0-9]+\\.[0-9]+$" }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "pdf_source": {
            "properties": { "mode": { "const": "actions-artifact" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "pdf_source": {
            "required": ["mode", "workflow_run_id", "artifact_id", "artifact_name"]
          }
        }
      }
    }
  ]
}

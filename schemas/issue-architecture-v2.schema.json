{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/issue-architecture-v2.schema.json",
  "title": "Survey Production Core v2 Issue Architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "research_profile", "publication_profile", "status", "basis", "editorial_thesis", "architecture_goals", "page_plan", "packages", "selected_exceptions", "profile_extensions", "publication_extensions", "human_review"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "research_profile": {"enum": ["WEEKLY", "RETROSPECTIVE_PERIOD", "THEMATIC"]},
    "publication_profile": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "APPROVED"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_profile_sha256", "profile_completeness_sha256", "materiality_ledger_sha256", "candidate_matrix_sha256", "candidate_selection_sha256"],
      "properties": {
        "production_profile_sha256": {"$ref": "#/$defs/sha256"},
        "profile_completeness_sha256": {"$ref": "#/$defs/sha256"},
        "materiality_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "editorial_thesis": {"type": "string", "minLength": 1},
    "architecture_goals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "page_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_pages", "max_pages", "notes"],
      "properties": {
        "target_pages": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "max_pages": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "notes": {"type": ["string", "null"]}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "title", "purpose", "primary_candidate_ids", "supporting_candidate_ids", "must_cover_requirements", "boundaries", "drafting_order", "profile_extensions", "publication_extensions"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "primary_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "supporting_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "must_cover_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "boundaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "drafting_order": {"type": "integer", "minimum": 1},
          "profile_extensions": {"type": "object"},
          "publication_extensions": {"type": "object"}
        }
      }
    },
    "selected_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reason", "exception_kind"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "exception_kind": {"enum": ["OMITTED_FROM_ARCHITECTURE", "DEFERRED", "STRUCTURAL_EXCEPTION"]}
        }
      }
    },
    "profile_extensions": {"type": "object"},
    "publication_extensions": {"type": "object"},
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_at", "review_reference"],
      "properties": {
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "review_reference": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

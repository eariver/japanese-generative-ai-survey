{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/discovery-acceptance-v2.schema.json",
  "title": "Survey Production Core v2 Discovery Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "x_source_intake", "discovery_path", "discovery_sha256", "record_count", "records", "graph_sha256"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "x_source_intake": {"$ref": "#/$defs/authority"},
    "discovery_path": {"type": "string", "minLength": 1},
    "discovery_sha256": {"$ref": "#/$defs/sha256"},
    "record_count": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/acceptedRecord"}
    },
    "graph_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0}
      }
    },
    "parentEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "ref", "issue_id", "discovery_id"],
      "properties": {
        "scope": {"enum": ["SAME_RUN", "EXTERNAL"]},
        "ref": {"type": "string", "minLength": 1},
        "issue_id": {"type": ["string", "null"]},
        "discovery_id": {"type": "string", "minLength": 1}
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "refs"],
      "properties": {
        "kind": {"enum": ["PROFILE_SEED", "PARENT_EDGE", "CARRY_OVER", "OBLIGATION_GAP"]},
        "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "collector_id", "collector_run_id", "trigger"],
      "properties": {
        "kind": {
          "enum": [
            "BASE",
            "CARRY_OVER",
            "REFERENCE_EXPANSION",
            "SUCCESSOR_EXPANSION",
            "PARALLEL_EXPANSION",
            "COMPETING_EXPANSION",
            "BRIDGE_EXPANSION",
            "GAP_FILL"
          ]
        },
        "collector_id": {"type": "string", "minLength": 1},
        "collector_run_id": {"type": "string", "minLength": 1},
        "trigger": {"$ref": "#/$defs/trigger"}
      }
    },
    "acceptedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_id", "origin", "research_pass", "parent_edges", "obligation_ids", "method", "source_locator", "raw_refs"],
      "properties": {
        "discovery_id": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "research_pass": {"type": "integer", "minimum": 0},
        "parent_edges": {"type": "array", "items": {"$ref": "#/$defs/parentEdge"}},
        "obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "method": {"$ref": "#/$defs/method"},
        "source_locator": {"type": "string", "minLength": 1},
        "raw_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}}
      }
    }
  }
}

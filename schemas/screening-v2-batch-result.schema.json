{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/screening-v2-batch-result.schema.json",
  "title": "Survey Production Core v2 Screening Batch Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "batch_id", "basis", "decisions"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9]{3}$"},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_sha256", "batch_sha256", "profile_sha256", "state_sha256", "prompt_sha256", "result_contract_sha256"],
      "properties": {
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "batch_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "state_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "result_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discovery_id", "decision", "reason", "scope_tags", "duplicate_group", "verification_targets", "confidence"],
        "properties": {
          "discovery_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["KEEP", "MAYBE", "DROP", "INSPECT"]},
          "reason": {"type": "string", "minLength": 1},
          "scope_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "duplicate_group": {"type": ["string", "null"]},
          "verification_targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

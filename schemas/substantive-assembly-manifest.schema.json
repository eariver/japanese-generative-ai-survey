{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/substantive-assembly-manifest.schema.json",
  "title": "Weekly Survey Substantive Assembly Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "status",
    "passed",
    "draft_package_manifest_sha256",
    "section_count",
    "sections",
    "merged_bibliography",
    "substantive_inputs",
    "deferred_packages",
    "errors"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "status": { "enum": ["substantive-assembly-ready", "substantive-assembly-invalid"] },
    "passed": { "type": "boolean" },
    "draft_package_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "section_count": { "type": "integer", "minimum": 0 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "package_type", "drafting_order", "source_render_manifest", "section_path", "section_sha256", "bib_source_sha256"],
        "properties": {
          "package_id": { "type": "string", "minLength": 1 },
          "package_type": { "type": "string", "minLength": 1 },
          "drafting_order": { "type": "integer", "minimum": 1 },
          "source_render_manifest": { "type": "string", "minLength": 1 },
          "section_path": { "type": "string", "minLength": 1 },
          "section_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bib_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "merged_bibliography": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "deduplicated_keys": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["path", "sha256", "entry_count", "deduplicated_keys"],
      "additionalProperties": false
    },
    "substantive_inputs": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "deferred_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "package_type", "execution_stage", "drafting_order"],
        "properties": {
          "package_id": { "type": "string", "minLength": 1 },
          "package_type": { "type": "string", "minLength": 1 },
          "execution_stage": { "enum": ["POST_DRAFT_SUMMARY", "REFERENCE_GENERATION"] },
          "drafting_order": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/candidate-comparison-record.schema.json",
  "title": "Weekly Survey Candidate Comparison Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "comparison_id",
    "candidate_id",
    "evidence_task_id",
    "artifact",
    "evidence",
    "temporal",
    "topic_lanes",
    "source_depth",
    "claim_counts",
    "metric_count",
    "limitation_count",
    "unresolved_questions",
    "contradictions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "comparison_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": ["string", "null"] },
    "evidence_task_id": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "artifact_type", "organization", "canonical_url"],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "organization": { "type": ["string", "null"] },
        "canonical_url": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recommendation", "rationale", "why_now_confirmed", "why_now_note", "grouping_note"],
      "properties": {
        "status": { "enum": ["VERIFIED", "PARTIAL", "REJECTED", "NEEDS_MORE"] },
        "recommendation": { "enum": ["CANDIDATE", "HOLD", "REJECT", "INSPECT_MORE"] },
        "rationale": { "type": "string", "minLength": 1 },
        "why_now_confirmed": { "type": "boolean" },
        "why_now_note": { "type": ["string", "null"] },
        "grouping_note": { "type": ["string", "null"] }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_first_announced", "events", "position_hints"],
      "properties": {
        "artifact_first_announced": { "type": ["string", "null"] },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_type", "event_date", "source_published_at", "position_hint"],
            "properties": {
              "event_type": { "type": "string", "minLength": 1 },
              "event_date": { "type": ["string", "null"] },
              "source_published_at": { "type": ["string", "null"] },
              "position_hint": {
                "enum": ["PRE_WINDOW", "MAIN_WINDOW", "CUTOFF_DAY_UNRESOLVED", "POST_CUTOFF", "UNKNOWN"]
              }
            }
          }
        },
        "position_hints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["PRE_WINDOW", "MAIN_WINDOW", "CUTOFF_DAY_UNRESOLVED", "POST_CUTOFF", "UNKNOWN"]
          }
        }
      }
    },
    "topic_lanes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-L]$" }
    },
    "source_depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_class"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_class": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "claim_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "metric_count": { "type": "integer", "minimum": 0 },
    "limitation_count": { "type": "integer", "minimum": 0 },
    "unresolved_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

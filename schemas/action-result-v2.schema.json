{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/action-result-v2.schema.json",
  "title": "Survey Production Core v2 Action Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "issue_id", "action_spec_sha256", "status", "handler", "implementation_commit_sha", "observed_repository_head_sha", "started_at", "completed_at", "state_before_sha256", "state_after_sha256", "outputs", "error"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "action_id": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "action_spec_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "RETRYABLE_FAILURE"]},
    "handler": {"type": ["string", "null"]},
    "implementation_commit_sha": {"$ref": "#/$defs/gitsha"},
    "observed_repository_head_sha": {"$ref": "#/$defs/gitsha"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "state_before_sha256": {"$ref": "#/$defs/sha256"},
    "state_after_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "checkpoint", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "checkpoint": {"type": ["string", "null"]},
          "path": {"type": ["string", "null"]},
          "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/action-spec-v2.schema.json",
  "title": "Survey Production Core v2 Action Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "action_id", "issue_id", "current_stage", "target_gate",
    "action_kind", "handler", "validator", "validator_version", "basis",
    "required_inputs", "expected_outputs", "retry_policy", "idempotency",
    "next_state", "next_terminal_reason"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "action_id": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "current_stage": {"type": "string", "minLength": 1},
    "target_gate": {"enum": ["ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW"]},
    "action_kind": {"enum": ["LOCAL_SCRIPT", "WORKFLOW_DISPATCH", "HUMAN_GATE", "COMPLETE", "EXCEPTION"]},
    "handler": {"type": ["string", "null"]},
    "validator": {"type": ["string", "null"]},
    "validator_version": {"type": ["string", "null"]},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_state_sha256", "production_profile_sha256", "pipeline_contract_sha256", "quality_contract_sha256", "implementation_commit_sha", "observed_repository_head_sha", "orchestrator_version"],
      "properties": {
        "production_state_sha256": {"$ref": "#/$defs/sha256"},
        "production_profile_sha256": {"$ref": "#/$defs/sha256"},
        "pipeline_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_contract_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_commit_sha": {"$ref": "#/$defs/gitsha"},
        "observed_repository_head_sha": {"$ref": "#/$defs/gitsha"},
        "orchestrator_version": {"type": "string", "minLength": 1}
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "checkpoint", "path", "required"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "checkpoint": {"type": ["string", "null"]},
          "path": {"type": ["string", "null"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retryable", "max_attempts"],
      "properties": {
        "retryable": {"type": "boolean"},
        "max_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "key"],
      "properties": {
        "mode": {"enum": ["NONE", "ACTION_ID", "EXTERNAL_KEY"]},
        "key": {"type": ["string", "null"]}
      }
    },
    "next_state": {"type": ["string", "null"]},
    "next_terminal_reason": {"enum": [null, "HUMAN_GATE_REACHED", "EXCEPTION_GATE_REQUIRED", "COMPLETE"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "required": {"type": "boolean"}
      }
    }
  }
}

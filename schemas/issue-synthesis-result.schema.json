{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/issue-synthesis-result.schema.json",
  "title": "Survey Post-Draft Issue Synthesis Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "synthesis_version", "status", "basis", "runner", "cover", "this_week_signals"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^(?:[0-9]{4}-W[0-9]{2}|SP-[A-Z0-9][A-Z0-9-]{2,63})$" },
    "synthesis_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["DRAFT", "REVISED"] },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthesis_input_sha256", "prompt_id", "prompt_sha256"],
      "properties": {
        "synthesis_input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prompt_id": { "const": "issue-synthesis-v0.1" },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "invocation", "generated_at"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "invocation": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "run_reference": { "type": ["string", "null"] }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "deck", "anchor_package_ids"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "deck": { "type": "string", "minLength": 1 },
        "anchor_package_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "this_week_signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "title", "summary", "package_ids", "late_breaking"],
        "properties": {
          "signal_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "package_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "late_breaking": { "type": "boolean" }
        }
      }
    }
  }
}

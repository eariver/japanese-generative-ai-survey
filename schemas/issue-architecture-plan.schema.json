{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/issue-architecture-plan.schema.json",
  "title": "Weekly Survey Issue Architecture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "architecture_version",
    "status",
    "basis",
    "approval",
    "editorial_thesis",
    "architecture_goals",
    "page_budget",
    "cover",
    "packages",
    "this_week_summary_written_last"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "architecture_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["PROPOSED", "APPROVED"] },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_input_sha256", "selection_sha256", "matrix_sha256"],
      "properties": {
        "architecture_input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "selection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "matrix_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "approval_reference"],
      "properties": {
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "approval_reference": { "type": ["string", "null"] }
      }
    },
    "editorial_thesis": { "type": "string", "minLength": 1 },
    "architecture_goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "page_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "max", "planned"],
      "properties": {
        "target": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "planned": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline_deferred", "headline", "anchor_candidates"],
      "properties": {
        "headline_deferred": { "const": true },
        "headline": { "type": "null" },
        "anchor_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "title",
          "package_type",
          "primary_evidence_task_ids",
          "supporting_evidence_task_ids",
          "page_target",
          "editorial_angle",
          "must_cover",
          "boundaries",
          "late_breaking",
          "drafting_order"
        ],
        "properties": {
          "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "package_type": {
            "enum": [
              "FRONTMATTER",
              "LEAD",
              "FEATURE",
              "COMPARISON",
              "SECTION",
              "DEEP_DIVE",
              "PAPER_WATCH",
              "X_COMMUNITY",
              "LATE_BREAKING",
              "WATCHLIST_CHRONOLOGY",
              "REFERENCES"
            ]
          },
          "primary_evidence_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "supporting_evidence_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "page_target": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 },
          "editorial_angle": { "type": "string", "minLength": 1 },
          "must_cover": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "boundaries": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "late_breaking": { "type": "boolean" },
          "drafting_order": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "this_week_summary_written_last": { "const": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/final-issue-preflight.schema.json",
  "title": "Weekly Survey Final Issue Source Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "passed",
    "final_source_manifest_sha256",
    "article_section_count",
    "package_labels",
    "page_reference_labels",
    "citation_keys",
    "bibliography_keys",
    "missing_bibliography_keys",
    "unused_bibliography_keys",
    "errors"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "passed": { "type": "boolean" },
    "final_source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "article_section_count": { "type": "integer", "minimum": 0 },
    "package_labels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "page_reference_labels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "citation_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "bibliography_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "missing_bibliography_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "unused_bibliography_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

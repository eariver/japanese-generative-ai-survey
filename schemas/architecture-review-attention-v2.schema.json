{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/architecture-review-attention-v2.schema.json",
  "title": "Survey Production Core v2 Architecture Review Attention",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "basis", "limit", "total_count", "shown_count", "overflow_count", "truncated", "counts", "items"],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screening_acceptance_path", "screening_acceptance_sha256", "materiality_ledger_path", "materiality_ledger_sha256", "candidate_selection_path", "candidate_selection_sha256"],
      "properties": {
        "screening_acceptance_path": {"type": "string", "minLength": 1},
        "screening_acceptance_sha256": {"$ref": "#/$defs/sha256"},
        "materiality_ledger_path": {"type": "string", "minLength": 1},
        "materiality_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_selection_path": {"type": "string", "minLength": 1},
        "candidate_selection_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "total_count": {"type": "integer", "minimum": 0},
    "shown_count": {"type": "integer", "minimum": 0},
    "overflow_count": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "stage", "subject_id", "decision", "rationale"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "stage": {"enum": ["SCREENING", "MATERIALITY", "SELECTION"]},
          "subject_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["DROP", "MAYBE", "INSPECT", "HOLD", "NON_MATERIAL", "EXCLUDED", "DUPLICATE", "REJECT"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/article-drafting-package.schema.json",
  "title": "Weekly Survey Article Drafting Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "package_id",
    "runner_mode",
    "basis",
    "package",
    "primary_evidence",
    "supporting_evidence",
    "source_catalog",
    "article_constraints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "runner_mode": { "enum": ["LLM_DRAFT", "DEFERRED_FRONTMATTER", "DETERMINISTIC_REFERENCES"] },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_plan_sha256", "architecture_input_sha256", "evidence_reviewed_sha256", "editorial_style_guide_sha256"],
      "properties": {
        "architecture_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "architecture_input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence_reviewed_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "editorial_style_guide_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "package_type", "page_target", "editorial_angle", "must_cover", "boundaries", "late_breaking", "drafting_order"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "package_type": { "type": "string", "minLength": 1 },
        "page_target": { "type": "number", "exclusiveMinimum": 0 },
        "editorial_angle": { "type": "string", "minLength": 1 },
        "must_cover": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "late_breaking": { "type": "boolean" },
        "drafting_order": { "type": "integer", "minimum": 1 }
      }
    },
    "primary_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_task_id", "role", "card"],
        "properties": {
          "evidence_task_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "card": { "type": "object" }
        }
      }
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_task_id", "role", "card"],
        "properties": {
          "evidence_task_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "card": { "type": "object" }
        }
      }
    },
    "source_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation_key", "evidence_task_id", "source_id", "source_class", "title", "url", "published_at", "role"],
        "properties": {
          "citation_key": { "type": "string", "pattern": "^ev-[0-9a-f]{10}-[a-z0-9-]+$" },
          "evidence_task_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "source_class": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "published_at": { "type": ["string", "null"] },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "article_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_new_facts_outside_evidence", "preserve_evidence_classes", "preserve_boundaries", "use_only_catalog_citations", "cover_headline_deferred", "this_week_summary_written_last"],
      "properties": {
        "no_new_facts_outside_evidence": { "const": true },
        "preserve_evidence_classes": { "const": true },
        "preserve_boundaries": { "const": true },
        "use_only_catalog_citations": { "const": true },
        "cover_headline_deferred": { "const": true },
        "this_week_summary_written_last": { "const": true }
      }
    }
  }
}

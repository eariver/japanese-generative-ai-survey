{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/thematic-scope-spec-v2.schema.json",
  "title": "Survey Production Core v2 Thematic Scope Materialization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "planning_authority",
    "question",
    "inclusion",
    "exclusion",
    "scope_dimensions",
    "initial_obligations",
    "materialized_by",
    "materialized_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "issue_id": {"type": "string", "minLength": 1},
    "planning_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entry", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "question": {"type": "string", "minLength": 1},
    "inclusion": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "exclusion": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "scope_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "initial_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "dimension", "description"],
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "dimension": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "materialized_by": {"type": "string", "minLength": 1},
    "materialized_at": {"type": "string", "format": "date-time"}
  }
}

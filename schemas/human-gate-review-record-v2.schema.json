{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eariver/japanese-generative-ai-survey/schemas/human-gate-review-record-v2.schema.json",
  "title": "Survey Production Core v2 Human Gate Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "issue_id",
    "gate",
    "revision",
    "decision",
    "reviewed_state",
    "reviewed_artifacts",
    "reviewed_repository_commit_sha",
    "reviewed_by",
    "reviewed_at",
    "review_reference",
    "requested_changes",
    "regeneration_boundary",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": "2.0-rc1"},
    "review_id": {"type": "string", "minLength": 1},
    "issue_id": {"type": "string", "minLength": 1},
    "gate": {"enum": ["ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW"]},
    "revision": {"type": "integer", "minimum": 1},
    "decision": {"enum": ["APPROVED", "REQUEST_CHANGES"]},
    "reviewed_state": {"$ref": "#/$defs/authority"},
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/namedAuthority"}
    },
    "reviewed_repository_commit_sha": {"$ref": "#/$defs/sha40"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "review_reference": {"type": "string", "minLength": 1},
    "requested_changes": {"type": ["string", "null"]},
    "regeneration_boundary": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "ISSUE_INITIALIZED",
            "DISCOVERY_COLLECTED",
            "CANDIDATES_NORMALIZED",
            "EVIDENCE_REVIEWED",
            "SELECTION_COMPLETE",
            "ARCHITECTURE_ESTABLISHED",
            "DRAFT_COMPLETE",
            "VALIDATED_DRAFT"
          ]
        }
      ]
    },
    "approval": {"$ref": "#/$defs/nullableAuthority"}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "APPROVED"}}},
      "then": {
        "properties": {
          "requested_changes": {"type": "null"},
          "regeneration_boundary": {"type": "null"},
          "approval": {"$ref": "#/$defs/authority"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "REQUEST_CHANGES"}}},
      "then": {
        "properties": {
          "requested_changes": {"type": "string", "minLength": 1},
          "regeneration_boundary": {"not": {"type": "null"}},
          "approval": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableAuthority": {
      "oneOf": [
        {"$ref": "#/$defs/authority"},
        {"type": "null"}
      ]
    },
    "namedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

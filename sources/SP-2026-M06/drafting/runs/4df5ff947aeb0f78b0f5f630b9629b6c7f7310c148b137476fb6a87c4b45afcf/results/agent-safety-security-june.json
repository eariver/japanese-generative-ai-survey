    },
    {
      "block_id": "adaptive-heading",
      "block_type": "HEADING",
      "text": "防御を知ったattackで評価する",
      "attribution_mode": "NONE",
      "evidence_refs": []
    },
    {
      "block_id": "adaptive-eval",
      "block_type": "PARAGRAPH",
      "text": "prompt injection防御の評価では、固定attackを同じ形で当て続けるだけでは防御の実力を測りにくい。Adaptive Evaluationの著者らは、defense-awareなattackへ適応させる評価を主張し、Progent/AgentDojoを用いた検証を行った。防御を公開した後の攻撃者適応まで評価modelへ入れる考え方である。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2026-M06:item-arxiv-2606-26479v1-8a5efbff54",
          "kind": "CLAIM",
          "evidence_id": "claim-1"
        }
      ]
    },
    {
      "block_id": "persistent-heading",
      "block_type": "HEADING",
      "text": "persistent agentはcomputer systemとして攻撃面が増える",
      "attribution_mode": "NONE",
      "evidence_refs": []
    },
    {
      "block_id": "safeclaw",
      "block_type": "PARAGRAPH",
      "text": "SafeClawArenaの著者らはClaw-likeなpersistent agentをcomputer systemとして捉え、単一promptだけでなく複数componentにまたがるattack surfaceを評価対象にした。長時間稼働し、toolやstateを持つagentでは、model inputだけを守ってもsystem全体のsecurityを説明できないという問題設定である。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2026-M06:item-arxiv-2606-30755v1-1555fea072",
          "kind": "CLAIM",
          "evidence_id": "claim-1"
        }
      ]
    },
    {
      "block_id": "mcp-heading",
      "block_type": "HEADING",
      "text": "MCPではtool集合そのものがtrust boundaryになる",
      "attribution_mode": "NONE",
      "evidence_refs": []
    },
    {
      "block_id": "sharelock",
      "block_type": "PARAGRAPH",
      "text": "ShareLockの著者らはMCP環境で、複数toolに分散したpoisoning情報を組み合わせるthreshold-style attackを提示した。個々のtoolを単独で検査して安全に見えても、agentが複数toolを横断して情報を統合した時にattackが成立し得るというthreat assumptionが重要である。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2026-M06:item-arxiv-2606-27027v1-92e00c43cb",
          "kind": "CLAIM",
          "evidence_id": "claim-1"
        }
      ]
    },
    {
      "block_id": "deployment-heading",
      "block_type": "HEADING",
      "text": "本番前に、過去の会話を候補modelへ再生する",
      "attribution_mode": "NONE",
      "evidence_refs": []

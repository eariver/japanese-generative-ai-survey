    {
      "block_id": "capability-authorization",
      "block_type": "PARAGRAPH",
      "text": "Capability Gates Are Not Authorizationの著者らは、agentにtool capabilityを見せる／隠す制御と、実際の各tool callで値やscopeを検証するauthorizationは別物だと整理した。一般的なagent frameworkを対象にconfused-deputy riskを示し、fail-closedなper-call controlの必要性を論じている。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2026-M06:item-arxiv-2606-28679v1-49b746661c",

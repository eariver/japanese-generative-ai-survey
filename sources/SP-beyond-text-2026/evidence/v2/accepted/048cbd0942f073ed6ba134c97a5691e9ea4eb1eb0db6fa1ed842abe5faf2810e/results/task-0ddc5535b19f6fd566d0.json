        "src-1"
      ],
      "context": "§2; App."
    },
    {
      "statement_id": "claim-2",
      "text": "Reported numbers: 250M pairs; MS-COCO zero-shot human vote 90.0% realism + 93.3% caption match vs DF-GAN; FID within ~2 pts of best prior; 21% COCO / 12% CUB train overlap with no result change.",
      "subject_id": "evr2-btd005",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "PRIMARY_FACT",

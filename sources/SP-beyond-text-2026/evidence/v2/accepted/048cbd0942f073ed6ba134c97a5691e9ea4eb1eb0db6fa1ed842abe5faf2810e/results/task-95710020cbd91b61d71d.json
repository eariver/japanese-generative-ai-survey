  "claims": [
    {
      "statement_id": "claim-1",
      "text": "The source defines the Fréchet Audio Distance: VGGish 128-dim embeddings on 1-second windows (0.5 s step) with Fréchet distance between Gaussians of eval set vs clean background set (Magnatagatune 540 h background / 60 h eval); validated across 13 distortion families with intensity sweeps.",
      "subject_id": "evr2-btd088",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "PRIMARY_FACT",
      "source_ids": [
        "src-1"
      ],
      "context": "§§2-3."
    },
    {
      "statement_id": "claim-2",
      "text": "Reported numbers: human correlation 0.52 vs SDR 0.39, cosine −0.15, magnitude-L2 −0.01 (69,300 pairs, 20 raters, 300 5 s clips); clean-audio FAD 0.2; usable from ~300 clips/25 min.",
      "subject_id": "evr2-btd088",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "PRIMARY_FACT",
      "source_ids": [
        "src-1"
      ],
      "context": "§4/conditions."
    }
  ],

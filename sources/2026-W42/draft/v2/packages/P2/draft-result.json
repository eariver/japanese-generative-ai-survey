          "kind": "CLAIM",
          "evidence_id": "claim-5",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p2-p10",
      "block_type": "PARAGRAPH",
      "text": "HBM4 8基・288GB・18TB/sという構成は、文脈の長さとバッチの大きさを支える物理量だ。MXFP4と3ビット未満の低精度、softmaxやcastのベクトルISAは、推論特化の方向性を示す。ただしこれらがどれだけ実効性能に効くかは、ベンダーの効率主張とは別の測定が要る。回路の存在と効率の程度は別の事柄だ。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-2",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-3",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"

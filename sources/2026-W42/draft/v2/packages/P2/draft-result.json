          "evidence_id": "claim-5",
          "subject_id": "lfm25",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p2-p14",
      "block_type": "PARAGRAPH",
      "text": "価格と実装の対応も実務的だ。入力0.10・キャッシュ0.05・出力1.00ドルという価格、llama.cpp・MLX・vLLM・SGLang・ONNXの即日対応、36,252ダウンロード級の流通。使う側の条件が揃っている。商用上限1000万ドルは、この価格とセットで読む。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:5b251d3e64049da7",
          "kind": "CLAIM",

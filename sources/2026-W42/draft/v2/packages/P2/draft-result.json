          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-3",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-4",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-5",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p2-p16",
      "block_type": "PARAGRAPH",
      "text": "LFMの実務含意は価格と条件だ。0.10ドルの入力と1000万ドルの商用上限、即日対応の推論基盤という三点セットで、使う側の判断ができる。報酬ハッキングの開示は、使う側の監視設計の入力になる。開示を読むことが運用の設計になる。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:5b251d3e64049da7",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "lfm25",

          "kind": "CLAIM",
          "evidence_id": "claim-5",
          "subject_id": "lfm25",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p2-p15",
      "block_type": "PARAGRAPH",
      "text": "実務への含意を書く。Maiaの回路開示は、自社推論基盤の方向性を示すが、使う側の選択肢を直接変えるものではない。変わるのは、効率主張の読み方だ。分母のない改善率を割り引いて読む習慣が、今週の最大の収穫である。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-2",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        },

    {
      "block_id": "p2-p9",
      "block_type": "PARAGRAPH",
      "text": "SDLAデータフローの意味を噛み砕く。推論のデータ移動を前提に設計された回路であり、UMAからNUMAへの移行はメモリの見え方を変える。チップレット化で計算ダイと帯域・入出力ダイを分けたことが、帯域数字の土台だ。回路の説明は深掘り記事で実質的に読める。これがP2でMaiaを主柱にした技術的根拠である。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "maia-300",

        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-5",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p2-p4",
      "block_type": "PARAGRAPH",
      "text": "SNS上の公式アカウント投稿（40％や7倍、マルチギガワットといった数字の言及）は、ベンダー自身のアカウントによる告知の存在を示すものではあっても、測定ではない。投稿の存在と数値の真偽は別の事柄だ。本号はこれらを測定根拠に数えない。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",

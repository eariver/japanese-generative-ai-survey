        },
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-5",
          "subject_id": "maia-300",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p2-p11",
      "block_type": "PARAGRAPH",
      "text": "相互接続の記述も読む。独自Ethernet伝送、96ポッド、光の第2層で12,288規模、prefillとdecodeの分離、ピア間750GB/s。学習用とは違う推論用の fabric が組まれていることが分かる。ホットスペアやテレメトリ・RASは運用の現実であり、発表の飾りではない。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "maia-300",

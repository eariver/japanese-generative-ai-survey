          "evidence_id": "claim-4",
          "subject_id": "distillation-defenses",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p5-p4",
      "block_type": "PARAGRAPH",
      "text": "較正の数字もベンダー報告だ。SWE-Verifiedで全文80.4％対要約71.8％という transcript の価値の定量化、収益・兆単位の拒否・統合更新・善良停止への課金といった trade-off の自認。防御は迂回可能と明記されている点も重要で、防御の完成宣言として読んではならない。効果の数字は発行元計測である。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:06bd3bc8489aedaf",
          "kind": "CLAIM",
          "evidence_id": "claim-1",

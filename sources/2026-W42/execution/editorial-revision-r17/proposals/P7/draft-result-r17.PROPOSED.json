          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "t7-12",
      "block_type": "PARAGRAPH",
      "text": "Harvey LAB 19.2％（基盤6.67％から12.5ポイント）の意味を確認する。基盤からの改善幅が明示されている点が良い。LegalBench同等という主張と、Vals 86.23対Fable 88.56という独立値の並置で、主張と根拠の対応が見える。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:9565853f1823de4e",
          "kind": "CLAIM",

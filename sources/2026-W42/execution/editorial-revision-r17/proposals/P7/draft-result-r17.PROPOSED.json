          "evidence_id": "claim-3",
          "subject_id": "glm-legal",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "t7-13",
      "block_type": "PARAGRAPH",
      "text": "凍結基盤モデル依存の含意を確認する。弱いモデルで未検証というのは、試用の条件が狭いということだ。強い基盤での結果を弱い基盤に外挿してはならない。外挿の禁止が、試用判断の条件になる。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:35690dfbac78389c",
          "kind": "CLAIM",
          "evidence_id": "claim-1",

    {
      "block_id": "t7-11",
      "block_type": "PARAGRAPH",
      "text": "PLawBenchと限定ベータ、後のAutoClawという記述は、提供の段階を示す。限定ベータという現状と、後の拡張という予定を分けて書く。現状と予定を混ぜない。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:2026-W42:9565853f1823de4e",
          "kind": "CLAIM",
          "evidence_id": "claim-1",

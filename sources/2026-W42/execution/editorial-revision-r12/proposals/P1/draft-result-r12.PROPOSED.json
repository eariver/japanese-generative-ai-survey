   ]
  },
  {
   "block_id": "r1-04",
   "block_type": "PARAGRAPH",
   "text": "二つの機構の関係を一次定義から整理する。Active Memoryは会話をまたぐ文脈の保持であり、Active Focusは遂行中の注意の維持である。前者が「覚えていること」、後者が「やり遂げること」に対応する。定義を読む限り、記憶の保持範囲や削除・訂正の手段の詳細は公開資料からは確認できない。使う側は確認と明確化の運用を組み込む必要がある。",
   "attribution_mode": "MIXED",
   "evidence_refs": [
    {
     "evidence_task_id": "evidence:2026-W42:f362a39cc1058b41",
     "kind": "CLAIM",
     "evidence_id": "claim-1",
     "subject_id": "muse-wonder",
     "subject_role": "PRIMARY_SUBJECT"
    },

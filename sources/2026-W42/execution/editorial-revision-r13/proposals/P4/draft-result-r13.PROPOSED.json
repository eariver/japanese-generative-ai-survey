   ]
  },
  {
   "block_id": "s4-07",
   "block_type": "PARAGRAPH",
   "text": "GitHubのHydraFusion（＋Max）は、複数モデルの編成という一段抽象度の高い主題だ。タスクごとに選択させず、Opus 5.5・Astra・Sol・Lunaのプールから経路づける。草案は軽め・査読は重めの労力調整、Cascadeの判定段階、Critiqueの作業空間と並列批評。Maxは労力を上げて編成効率で回収する位置づけで、VSCode・アプリ・CLIに研究プレビューとして提供され、上位プラン以上と組織方針が条件になる。プレビューであること、発行者の効率主張であることを留保つきで読む。",
   "attribution_mode": "ATTRIBUTED",
   "evidence_refs": [
    {
     "evidence_task_id": "evidence:2026-W42:bd1c22a5606820e8",
     "kind": "CLAIM",
     "evidence_id": "claim-1",
     "subject_id": "hydrafusion",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:bd1c22a5606820e8",
     "kind": "CLAIM",
     "evidence_id": "claim-2",
     "subject_id": "hydrafusion",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:bd1c22a5606820e8",
     "kind": "CLAIM",
     "evidence_id": "claim-3",
     "subject_id": "hydrafusion",
     "subject_role": "PRIMARY_SUBJECT"
    }
   ]
  },
  {
   "block_id": "s4-08",
   "block_type": "PARAGRAPH",
   "text": "Maxは労を上げて編成効率で回収する位置づけであり上位プランと組織方針が条件だ。労力調整の段差が、使う側の選択肢になる。",
   "attribution_mode": "ATTRIBUTED",
   "evidence_refs": [
    {
     "evidence_task_id": "evidence:2026-W42:bd1c22a5606820e8",
     "kind": "CLAIM",

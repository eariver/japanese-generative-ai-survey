     "kind": "CLAIM",
     "evidence_id": "claim-3",
     "subject_id": "scion",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:e0383c9e60cd433c",
     "kind": "CLAIM",
     "evidence_id": "claim-4",
     "subject_id": "scion",

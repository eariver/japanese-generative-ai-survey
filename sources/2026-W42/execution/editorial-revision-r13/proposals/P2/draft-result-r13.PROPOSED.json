    },
    {
     "evidence_task_id": "evidence:2026-W42:5b251d3e64049da7",
     "kind": "CLAIM",
     "evidence_id": "claim-5",
     "subject_id": "lfm25",
     "subject_role": "PRIMARY_SUBJECT"
    }
   ]
  },
  {
   "block_id": "s2-08",
   "block_type": "PARAGRAPH",
   "text": "LFM Open License v1.0はApacheベースに1000万ドルの商用上限（第2〜5条・第11条）を設け、研究利用に影響しない。確認できたのは発行者サイトで公開された主要条項であり、対象モデルのLICENSE原文ファイルおよび24B個別重みの確認は未了である。タグのみの証拠とは区別されるが、Beamのようなリポジトリ全文確認とも水準が違う。価格は100万トークンあたり入力0.10ドル、キャッシュ0.05ドルとされる（発行元記載）。",
   "attribution_mode": "ATTRIBUTED",
   "evidence_refs": [
    {
     "evidence_task_id": "evidence:2026-W42:5b251d3e64049da7",
     "kind": "CLAIM",

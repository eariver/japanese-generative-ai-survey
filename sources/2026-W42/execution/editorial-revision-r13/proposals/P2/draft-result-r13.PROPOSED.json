 "blocks": [
  {
   "block_id": "s2-01",
   "block_type": "HEADING",
   "text": "数字の前に回路を、効率の前に分母を",
   "attribution_mode": "NONE",
   "evidence_refs": []
  },
  {
   "block_id": "s2-02",
   "block_type": "PARAGRAPH",
   "text": "Microsoftは10月12日、推論アクセラレータAzure Maia 300の体系を公開した。SDLAデータフロー、UMAからNUMAへのチップレット化、N2Pコンピュートダイと帯域・入出力ダイの構成が中核である。HBM4を8基で288GB、帯域18TB/sというメモリ構成、MXFP4と3ビット未満の低精度、softmaxやキャスト演算を扱うベクトル命令セットといった要素が、深掘り記事で実質的に読める形で開示されている。",
   "attribution_mode": "MIXED",
   "evidence_refs": [
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-1",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-2",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-3",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {

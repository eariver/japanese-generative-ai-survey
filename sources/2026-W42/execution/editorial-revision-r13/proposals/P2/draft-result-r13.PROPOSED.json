     "kind": "CLAIM",
     "evidence_id": "claim-4",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-5",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    }
   ]
  },
  {
   "block_id": "s2-03",
   "block_type": "PARAGRAPH",
   "text": "相互接続とラック設計も具体性が高い。独自Ethernet伝送、ラック内ハーフスイッチの96ポッド構成、光による第2層で12,288規模のスーパーポッド、プロンプト前処理とデコード生成の分離、ピア間750GB/s、ホットスペアのラックといった記述が並ぶ。96トレイ・167kWのラックに6基のスイッチ用集積回路、50Vバスバーと自動切替装置、80％超の液体冷却、データセンターの計測と信頼性設計。クラウド事業者が自社推論基盤を拡張するという宣言の物理的裏づけとして読める。",
   "attribution_mode": "MIXED",
   "evidence_refs": [
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-1",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-2",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-3",
     "subject_id": "maia-300",
     "subject_role": "PRIMARY_SUBJECT"
    },
    {
     "evidence_task_id": "evidence:2026-W42:6a11623b7a984668",
     "kind": "CLAIM",
     "evidence_id": "claim-4",
     "subject_id": "maia-300",

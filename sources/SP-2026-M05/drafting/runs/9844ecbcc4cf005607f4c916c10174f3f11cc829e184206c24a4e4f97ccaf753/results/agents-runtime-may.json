    {
      "block_id": "item-05-heading",
      "block_type": "HEADING",
      "text": "Agentic AI Workload Characteristics",
      "attribution_mode": "NONE",
      "evidence_refs": []
    },
    {
      "block_id": "item-05",
      "block_type": "PARAGRAPH",
      "text": "この論文はReAct型agent workloadをend-to-endで観測し、反復するmodel call、tool execution、増大するcontextを一体のworkloadとして特徴づける。結果は著者報告だが、serving側から見てもagent requestが単発inferenceとは異なるstateful workloadになるという論点を補強する。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2026-M05:item-arxiv-2605-26297v1-3ac98fa507",

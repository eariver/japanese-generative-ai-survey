    {
      "block_id": "item-04-heading",
      "block_type": "HEADING",
      "text": "Mistral May 2026 technical releases",
      "attribution_mode": "NONE",
      "evidence_refs": []
    },
    {
      "block_id": "item-04",
      "block_type": "PARAGRAPH",
      "text": "MistralのMay snapshotでは、22日のMCP-enabled Studio toolingとWorkflows public preview、23日のremote agents、28日のVibe long-horizon Work/Code modesなどが並ぶ。agent featureがchat UIの追加機能ではなく、workflow、remote execution、MCP接続へ広がる方向が見える。",
      "attribution_mode": "ATTRIBUTED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2026-M05:item-official-index-mistral-news-e5054b4c4c",

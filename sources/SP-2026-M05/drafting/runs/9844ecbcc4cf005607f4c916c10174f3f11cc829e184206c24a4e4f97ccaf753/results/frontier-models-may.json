    {
      "block_id": "theme-synthesis-heading",
      "block_type": "HEADING",
      "text": "Theme Synthesis",
      "attribution_mode": "NONE",
      "evidence_refs": []
    },
    {
      "block_id": "theme-synthesis",
      "block_type": "PARAGRAPH",
      "text": "5月のfrontier領域では、モデル本体と利用surfaceを切り分けて評価する必要がさらに強まった。closed/API提供ではlifecycle変更が設計条件になり、voiceではモデル能力と低遅延配信の両方が体験を決める。したがって本稿では各社の性能表現を横断ランキングへ変換せず、公開形態・利用経路・更新単位の差を中心に読む。",
      "attribution_mode": "MIXED",

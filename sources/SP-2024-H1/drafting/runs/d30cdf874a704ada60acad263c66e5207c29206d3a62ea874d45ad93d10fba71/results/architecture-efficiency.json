  "blocks": [
    {
      "block_id": "constraint-driven",
      "block_type": "PARAGRAPH",
      "text": "2024年上期のarchitecture研究を横断すると、共通しているのは「より大きなdense Transformer」を唯一の解としない姿勢である。Jambaはhybrid architecture、Mamba-2はstate-space architectureの発展を示し、BitNet b1.58は低ビットweight表現、LongRoPEは長文脈拡張を研究対象にした。BitNetとLongRoPEの技術評価は各論文著者の報告として扱う。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2024-H1:item-official-index-supplemental-ai21-ja-97a4f32859",
          "kind": "EVENT",
          "evidence_id": "event-1"
        },
        {
          "evidence_task_id": "evidence:SP-2024-H1:item-arxiv-2405-21060v1-34ab887f2a",
          "kind": "EVENT",
          "evidence_id": "event-1"
        },
        {
          "evidence_task_id": "evidence:SP-2024-H1:item-arxiv-2402-17764v1-cf7e0465e5",
          "kind": "CLAIM",
          "evidence_id": "claim-1"
        },
        {
          "evidence_task_id": "evidence:SP-2024-H1:item-arxiv-2402-13753v1-a5ead6bb56",
          "kind": "CLAIM",
          "evidence_id": "claim-1"
        }
      ]
    },
    {
      "block_id": "hybrid-sparse",
      "block_type": "PARAGRAPH",
      "text": "Jamba、Mixtral 8x22B、DeepSeek-V2のようなモデルは、dense設計だけではないhybrid/sparseな構成を競争軸へ持ち込んだ。ここではarchitectureとserving implementationが密接に結びつくため、理論上のparameter効率と実際のhardware上の速度を同一視できない。",
      "attribution_mode": "INFERENCE",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-2024-H1:item-official-index-supplemental-ai21-ja-97a4f32859",
          "kind": "EVENT",
          "evidence_id": "event-1"
        },
        {
          "evidence_task_id": "evidence:SP-2024-H1:item-official-index-supplemental-mistral-9ae62fe6d3",

        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:9d0a4e5bc8df3260",
          "kind": "LIMITATION",
          "evidence_id": "limitation-1",
          "subject_id": "ev-vmd089",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p11-b8",
      "block_type": "PARAGRAPH",
      "text": "VSI-Benchは288本の一人称の動画に5131問を載せ、配置と計測と時空間の三つの型に8課題を置いた空間の評価である。MCAとMRAの指標と何も見ない条件との比較を備え、CoTで下がり認知地図で上がるという補助的手順の知見が報告される。記述は論文要旨の水準に留まり、偏りを除いた部分集合の分析には踏み込まない。空間の理解を助ける手順の効果を示す範囲での言及に留め、一般の推論の到達とは呼ばない。scaffoldの効果は範囲を限って読み、要旨の水準を超えた断定はしない。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {

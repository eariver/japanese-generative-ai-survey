  "blocks": [
    {
      "block_id": "p02-b1",
      "block_type": "PARAGRAPH",
      "text": "何がどこにあるかを結ぶ演算は、画像一枚の分類だけではまかなえない。手作り特徴の複雑な集成がVOC検出で停滞するなか、R-CNNはボトムアップの領域提案に大容量CNNを適用し、位置特定へのCNN利用と、分類の事前学習に検出領域へのファインチューニングを続ける手順の二点でVOC 2012のmAP 53.3パーセント、相対30パーセント超の改善を示したことが、原論文の主張として記録されている。古典的CVと深層学習の融合という読みも論文自身の枠づけである。多段パイプラインの速度は将来課題として残され、後年基準では遅いこと、誤り分析が当時のHoiemらの道具立てによることが限界として付随する。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:392343dab0a3215c",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "ev-vmd005",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:392343dab0a3215c",
          "kind": "CLAIM",
          "evidence_id": "claim-2",
          "subject_id": "ev-vmd005",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:392343dab0a3215c",
          "kind": "CLAIM",
          "evidence_id": "claim-3",
          "subject_id": "ev-vmd005",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:392343dab0a3215c",
          "kind": "LIMITATION",
          "evidence_id": "limitation-1",
          "subject_id": "ev-vmd005",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:392343dab0a3215c",
          "kind": "LIMITATION",
          "evidence_id": "limitation-2",

          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:46a40e71f36174e1",
          "kind": "CLAIM",
          "evidence_id": "claim-2",
          "subject_id": "ev-vmd041",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:46a40e71f36174e1",
          "kind": "LIMITATION",
          "evidence_id": "limitation-1",
          "subject_id": "ev-vmd041",
          "subject_role": "PRIMARY_SUBJECT"
        }
      ]
    },
    {
      "block_id": "p07b-b02",
      "block_type": "PARAGRAPH",
      "text": "語句グラウンディングの次に足りなかったのは、指示の曖昧さを解く評価と希少カテゴリを測る評価の切り分けであった。RefCOCO系列のREC契約は関係記述や曖昧記述のもとで単一対象を切り分けるものであり、構成的文脈のモデル化とグラウンディング正解率の指標の起点となったと論文著者が説明する。指示表現による単一対象の指定が入力であり、ボックスによる位置特定が出力である。ファインチューニングとゼロショットのRECは手順の違いであり、別の節点ではない。一方LVISは16.4万画像に1000超の基本水準カテゴリと約200万マスクをZipf分布で整え、希少と通常と頻出の区分によりLVIS-rareのAPをOVD評価の起点にしたとベンチマーク論文著者が説明する。ODinWは実世界・多様ドメイン評価の補完として位置づけられ、独立記録ではない。希少区分の手順は利用ごとに明示し、ウェブ事前学習の近接が未知の読みに影響する点に注意する。",
      "attribution_mode": "MIXED",
      "evidence_refs": [
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:a9d2a0a6c600dfb8",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "ev-vmd042",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:a9d2a0a6c600dfb8",
          "kind": "LIMITATION",
          "evidence_id": "limitation-1",
          "subject_id": "ev-vmd042",
          "subject_role": "PRIMARY_SUBJECT"
        },
        {
          "evidence_task_id": "evidence:SP-vision-multimodal-2026:d79a54d5c58f96d1",
          "kind": "CLAIM",
          "evidence_id": "claim-1",
          "subject_id": "ev-vmd056",

  "claims": [
    {
      "statement_id": "claim-1",
      "text": "7B self-supervised vision model on LVD-1689M (1,689M hierarchical sampling); objective L_Pre = L_DINO + L_iBOT + 0.1*L_DKoleo with Sinkhorn-Knopp replacing centering, axial RoPE, constant schedule over 1M iterations.",
      "subject_id": "ev-vmd113",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "src-1"
      ],
      "context": "Paper §3 (data/scale/objective/architecture)."
    },
    {
      "statement_id": "claim-2",
      "text": "Dense feature maps degrade under long training (VOC mIoU peaks ~200k then declines); fixed by Gram anchoring against an early Gram-teacher, preserving patch consistency without pinning features.",
      "subject_id": "ev-vmd113",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "src-1"
      ],
      "context": "Paper §3.2/§4.1-4.3 (degradation diagnosis + Gram refinement)."
    },
    {
      "statement_id": "claim-3",
      "text": "Post-hoc adaptation without retraining: resolution scaling, multi-student distillation to ViT-S/B/L/H+ and ConvNeXt, plus dino.txt LiT-style text alignment on frozen vision.",
      "subject_id": "ev-vmd113",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "src-1"
      ],
      "context": "Paper §5 (adaptation suite)."
    },
    {
      "statement_id": "claim-4",
      "text": "Inherits DINOv2 DINO+iBOT/multi-crop/Koleo/registers; changes scale, RoPE, Sinkhorn, Gram phase. Frozen reusable dense representation reaching task SOTA without fine-tuning.",
      "subject_id": "ev-vmd113",
      "subject_role": "PRIMARY_SUBJECT",
      "evidence_class": "AUTHOR_CLAIM",
      "source_ids": [
        "src-1"
      ],
      "context": "Paper §1/§6-8 (lineage + frozen-backbone results)."
    }
  ],

      },
      {
        "id": "automotive-ethernet-tsn",
        "search_query": "(all:\"automotive Ethernet\" OR all:\"in-vehicle Ethernet\") AND (all:\"TSN\" OR all:\"time-sensitive networking\" OR all:\"deterministic\")"
      },
      {
        "id": "automotive-soa",
        "search_query": "(all:\"automotive\" OR all:\"vehicle\") AND (all:\"service-oriented architecture\" OR all:\"SOME/IP\" OR all:\"vehicle service\")"
      },
      {
        "id": "sdv-cloud-edge-validation",
        "search_query": "(all:\"software-defined vehicle\" OR all:\"software defined vehicle\") AND (all:\"cloud\" OR all:\"virtual validation\" OR all:\"digital twin\" OR all:\"CI/CD\")"
      }

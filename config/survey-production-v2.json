{
  "schema_version": "2.0-rc1",
  "pipeline_contract_version": "2.0-rc1",
  "quality_contract_version": "2.0-rc1",
  "orchestrator_version": "survey-production-core-v2/0.4",
  "contract_files": {
    "pipeline": [
      "docs/survey-production-core-v2-authority.md",
      "docs/survey-production-core-v2-contract-normalization-second-audit-amendment.md",
      "docs/survey-production-core-v2-minimum-vertical-slice-second-audit-amendment.md",
      "docs/survey-production-core-v2-whole-system-audit-2026-08-22.md",
      "docs/survey-production-core-v2-whole-system-audit-remediation-closure.md",
      "schemas/survey-discovery-record.schema.json",
      "schemas/screening-v2-run-package.schema.json",
      "schemas/screening-v2-batch-result.schema.json",
      "config/prompts/source-screening-v2.md",
      "schemas/evidence-v2-run-package.schema.json",
      "schemas/evidence-v2-task.schema.json",
      "schemas/evidence-v2-card.schema.json",
      "schemas/edition-evidence-view.schema.json",
      "schemas/materiality-ledger.schema.json",
      "schemas/profile-completeness-result.schema.json",
      "config/prompts/evidence-verification-v2.md",
      "schemas/candidate-matrix-v2.schema.json",
      "schemas/candidate-selection-v2.schema.json",
      "schemas/issue-architecture-v2.schema.json",
      "schemas/architecture-review-summary-v2.schema.json",
      "schemas/architecture-approval-record-v2.schema.json",
      "schemas/draft-v2-package.schema.json",
      "schemas/draft-v2-result.schema.json",
      "schemas/profile-synthesis-v2-input.schema.json",
      "schemas/profile-synthesis-v2-result.schema.json",
      "config/prompts/article-drafting-v2.md",
      "config/prompts/profile-synthesis-v2.md",
      "schemas/action-spec-v2.schema.json",
      "schemas/action-result-v2.schema.json",
      "schemas/review-finding-v2.schema.json",
      "schemas/repair-set-v2.schema.json"
    ],
    "quality": [
      "docs/survey-production-core-v2-historical-invariants.md",
      "docs/survey-production-core-v2-historical-production-deep-audit.md"
    ]
  },
  "implementation_control_roots": ["config", "schemas", "scripts", ".github/workflows"],
  "research_profiles": {
    "WEEKLY": {
      "version": "2.0-rc1",
      "temporal_policies": ["ROLLING_WINDOW"],
      "role_namespace": "WEEKLY:",
      "synthesis_payload_required": ["signals", "current_interpretation", "carry_over_summary"]
    },
    "RETROSPECTIVE_PERIOD": {
      "version": "2.0-rc1",
      "temporal_policies": ["BOUNDED_PERIOD"],
      "role_namespace": "PERIOD:",
      "synthesis_payload_required": ["period_synthesis", "cross_feature_relationships", "residual_boundaries"]
    },
    "THEMATIC": {
      "version": "2.0-rc1",
      "temporal_policies": ["OPEN_HISTORY_AS_OF", "CURRENT_STATE_AS_OF"],
      "role_namespace": "THEMATIC:",
      "synthesis_payload_required": ["branch_transition_synthesis", "parallel_competing_relations", "unresolved_lineage_questions", "historical_attribution_boundaries"]
    }
  },
  "publication_profiles": {
    "WEEKLY_MAGAZINE": {
      "version": "2.0-rc1",
      "role_namespace": "WEEKLY_MAGAZINE:",
      "synthesis_payload_required": []
    },
    "LONGFORM_SPECIAL": {
      "version": "2.0-rc1",
      "role_namespace": "LONGFORM_SPECIAL:",
      "synthesis_payload_required": []
    }
  },
  "human_gates": ["ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW"],
  "terminal_reasons": ["HUMAN_GATE_REACHED", "EXCEPTION_GATE_REQUIRED", "COMPLETE"],
  "lifecycle_states": [
    "ISSUE_INITIALIZED",
    "DISCOVERY_COLLECTED",
    "CANDIDATES_NORMALIZED",
    "EVIDENCE_REVIEWED",
    "SELECTION_COMPLETE",
    "ARCHITECTURE_ESTABLISHED",
    "DRAFT_COMPLETE",
    "VALIDATED_DRAFT",
    "RELEASE_CANDIDATE",
    "FROZEN"
  ],
  "orchestration": {
    "retry_policy": {"retryable": true, "max_attempts": 3},
    "gate_at_state": {
      "ARCHITECTURE_ESTABLISHED": "ARCHITECTURE_REVIEW",
      "RELEASE_CANDIDATE": "PUBLICATION_PREVIEW"
    },
    "gate_inputs": {
      "ARCHITECTURE_REVIEW": [
        {"name": "issue-architecture", "path": "{source_root}/architecture-v2.json"},
        {"name": "architecture-review-summary", "path": "{source_root}/architecture-review-summary-v2.json"}
      ],
      "PUBLICATION_PREVIEW": []
    },
    "stage_plan": {
      "ISSUE_INITIALIZED": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:discovery", "next_state": "DISCOVERY_COLLECTED", "checkpoints": ["discovery"]},
      "DISCOVERY_COLLECTED": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:screening", "next_state": "CANDIDATES_NORMALIZED", "checkpoints": ["screening"]},
      "CANDIDATES_NORMALIZED": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:evidence-materiality-completeness", "next_state": "EVIDENCE_REVIEWED", "checkpoints": ["evidence", "materiality", "completeness"]},
      "EVIDENCE_REVIEWED": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:selection", "next_state": "SELECTION_COMPLETE", "checkpoints": ["selection"]},
      "SELECTION_COMPLETE": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:architecture",
        "next_state": "ARCHITECTURE_ESTABLISHED",
        "checkpoints": ["architecture"],
        "artifacts": [
          {"name": "issue-architecture", "path": "{source_root}/architecture-v2.json"},
          {"name": "architecture-review-summary", "path": "{source_root}/architecture-review-summary-v2.json"}
        ]
      },
      "ARCHITECTURE_ESTABLISHED": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:drafting-synthesis", "next_state": "DRAFT_COMPLETE", "checkpoints": ["draft"]},
      "DRAFT_COMPLETE": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:semantic-publication-validation", "next_state": "VALIDATED_DRAFT", "checkpoints": ["validation"]},
      "VALIDATED_DRAFT": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:publication-candidate", "next_state": "RELEASE_CANDIDATE", "checkpoints": []},
      "RELEASE_CANDIDATE": {"action_kind": "LOCAL_SCRIPT", "handler": "stage:freeze-release", "next_state": "FROZEN", "checkpoints": ["freeze"]}
    }
  },
  "state_authority": {
    "authoritative_filename": "production-state.json",
    "profile_filename": "production-profile.json",
    "legacy_filename": "pipeline-state.json",
    "legacy_mode": "NON_AUTHORITATIVE_READ_ONLY"
  }
}

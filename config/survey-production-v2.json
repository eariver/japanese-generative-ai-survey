{
  "schema_version": "2.0-rc1",
  "pipeline_contract_version": "2.0-rc1",
  "quality_contract_version": "2.0-rc1",
  "orchestrator_version": "survey-production-core-v2/0.7",
  "contract_files": {
    "pipeline": [
      "docs/survey-production-core-v2-authority.md",
      "docs/survey-production-core-v2-contract-normalization-second-audit-amendment.md",
      "docs/survey-production-core-v2-minimum-vertical-slice-second-audit-amendment.md",
      "docs/survey-production-core-v2-whole-system-audit-2026-08-22.md",
      "docs/survey-production-core-v2-whole-system-audit-remediation-closure.md",
      "config/survey-production-v2-requirements.txt",
      "schemas/survey-discovery-record.schema.json",
      "schemas/discovery-acceptance-v2.schema.json",
      "schemas/screening-v2-run-package.schema.json",
      "schemas/screening-v2-batch-result.schema.json",
      "config/prompts/source-screening-v2.md",
      "schemas/evidence-v2-run-package.schema.json",
      "schemas/evidence-v2-task.schema.json",
      "schemas/evidence-v2-card.schema.json",
      "schemas/edition-evidence-view.schema.json",
      "schemas/materiality-ledger.schema.json",
      "schemas/profile-completeness-result.schema.json",
      "config/prompts/evidence-verification-v2.md",
      "schemas/candidate-matrix-v2.schema.json",
      "schemas/candidate-selection-v2.schema.json",
      "schemas/issue-architecture-v2.schema.json",
      "schemas/architecture-review-summary-v2.schema.json",
      "schemas/architecture-review-attention-v2.schema.json",
      "schemas/architecture-approval-record-v2.schema.json",
      "schemas/draft-v2-package.schema.json",
      "schemas/draft-v2-result.schema.json",
      "schemas/profile-synthesis-v2-input.schema.json",
      "schemas/profile-synthesis-v2-result.schema.json",
      "config/prompts/article-drafting-v2.md",
      "config/prompts/profile-synthesis-v2.md",
      "schemas/quality-regression-bundle-v2.schema.json",
      "schemas/publication-candidate-v2.schema.json",
      "schemas/publication-preview-approval-v2.schema.json",
      "schemas/visual-review-record-v2.schema.json",
      "schemas/freeze-record-v2.schema.json",
      "schemas/release-manifest-v2.schema.json",
      "schemas/merge-verification-v2.schema.json",
      "schemas/release-record-v2.schema.json",
      "schemas/action-spec-v2.schema.json",
      "schemas/action-result-v2.schema.json",
      "schemas/stage-validation-attestation-v2.schema.json",
      "schemas/stage-handoff-v2.schema.json",
      "schemas/stage-handoff-request-v2.schema.json",
      "schemas/review-finding-v2.schema.json",
      "schemas/repair-set-v2.schema.json"
    ],
    "quality": [
      "docs/survey-production-core-v2-historical-invariants.md",
      "docs/survey-production-core-v2-historical-production-deep-audit.md"
    ]
  },
  "implementation_control_roots": ["config", "schemas", "scripts", ".github/workflows"],
  "research_profiles": {
    "WEEKLY": {
      "version": "2.0-rc1",
      "temporal_policies": ["ROLLING_WINDOW"],
      "role_namespace": "WEEKLY:",
      "synthesis_payload_required": ["signals", "current_interpretation", "carry_over_summary"]
    },
    "RETROSPECTIVE_PERIOD": {
      "version": "2.0-rc1",
      "temporal_policies": ["BOUNDED_PERIOD"],
      "role_namespace": "PERIOD:",
      "synthesis_payload_required": ["period_synthesis", "cross_feature_relationships", "residual_boundaries"]
    },
    "THEMATIC": {
      "version": "2.0-rc1",
      "temporal_policies": ["OPEN_HISTORY_AS_OF", "CURRENT_STATE_AS_OF"],
      "role_namespace": "THEMATIC:",
      "synthesis_payload_required": ["branch_transition_synthesis", "parallel_competing_relations", "unresolved_lineage_questions", "historical_attribution_boundaries"]
    }
  },
  "publication_profiles": {
    "WEEKLY_MAGAZINE": {
      "version": "2.0-rc1",
      "role_namespace": "WEEKLY_MAGAZINE:",
      "synthesis_payload_required": []
    },
    "LONGFORM_SPECIAL": {
      "version": "2.0-rc1",
      "role_namespace": "LONGFORM_SPECIAL:",
      "synthesis_payload_required": []
    }
  },
  "human_gates": ["ARCHITECTURE_REVIEW", "PUBLICATION_PREVIEW"],
  "terminal_reasons": ["HUMAN_GATE_REACHED", "EXCEPTION_GATE_REQUIRED", "COMPLETE"],
  "lifecycle_states": [
    "ISSUE_INITIALIZED",
    "DISCOVERY_COLLECTED",
    "CANDIDATES_NORMALIZED",
    "EVIDENCE_REVIEWED",
    "SELECTION_COMPLETE",
    "ARCHITECTURE_ESTABLISHED",
    "DRAFT_COMPLETE",
    "VALIDATED_DRAFT",
    "RELEASE_CANDIDATE",
    "FROZEN",
    "RELEASED"
  ],
  "orchestration": {
    "retry_policies": {
      "LOCAL_SCRIPT": {"retryable": true, "max_attempts": 3},
      "WORKFLOW_DISPATCH": {"retryable": false, "max_attempts": 1}
    },
    "gate_at_state": {
      "ARCHITECTURE_ESTABLISHED": "ARCHITECTURE_REVIEW",
      "RELEASE_CANDIDATE": "PUBLICATION_PREVIEW"
    },
    "gate_inputs": {
      "ARCHITECTURE_REVIEW": [
        {"name": "issue-architecture", "path": "{source_root}/architecture-v2.json"},
        {"name": "architecture-review-summary", "path": "{source_root}/architecture-review-summary-v2.json"},
        {"name": "architecture-review-attention", "path": "{source_root}/architecture-review-attention-v2.json"}
      ],
      "PUBLICATION_PREVIEW": [
        {"name": "publication-candidate", "path": "{source_root}/publication/v2/publication-candidate-v2.json"}
      ]
    },
    "stage_plan": {
      "ISSUE_INITIALIZED": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:discovery",
        "validator": "validate:discovery",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "DISCOVERY_COLLECTED",
        "checkpoints": ["discovery"],
        "artifacts": [
          {"name": "discovery-acceptance", "path": "{source_root}/discovery/discovery-accepted-v2.json"}
        ]
      },
      "DISCOVERY_COLLECTED": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:screening",
        "validator": "validate:screening",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "CANDIDATES_NORMALIZED",
        "checkpoints": ["screening"]
      },
      "CANDIDATES_NORMALIZED": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:evidence-materiality-completeness",
        "validator": "validate:evidence-materiality-completeness",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "EVIDENCE_REVIEWED",
        "checkpoints": ["evidence", "materiality", "completeness"]
      },
      "EVIDENCE_REVIEWED": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:selection",
        "validator": "validate:selection",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "SELECTION_COMPLETE",
        "checkpoints": ["selection"]
      },
      "SELECTION_COMPLETE": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:architecture",
        "validator": "validate:architecture",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "ARCHITECTURE_ESTABLISHED",
        "checkpoints": ["architecture"],
        "artifacts": [
          {"name": "issue-architecture", "path": "{source_root}/architecture-v2.json"},
          {"name": "architecture-review-summary", "path": "{source_root}/architecture-review-summary-v2.json"},
          {"name": "architecture-review-attention", "path": "{source_root}/architecture-review-attention-v2.json"}
        ]
      },
      "ARCHITECTURE_ESTABLISHED": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:drafting-synthesis",
        "validator": "validate:drafting-synthesis",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "DRAFT_COMPLETE",
        "checkpoints": ["draft"]
      },
      "DRAFT_COMPLETE": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:semantic-publication-validation",
        "validator": "validate:semantic-publication",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "VALIDATED_DRAFT",
        "checkpoints": ["validation"]
      },
      "VALIDATED_DRAFT": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:publication-candidate",
        "validator": "validate:publication-candidate",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "RELEASE_CANDIDATE",
        "checkpoints": [],
        "artifacts": [
          {"name": "publication-candidate", "path": "{source_root}/publication/v2/publication-candidate-v2.json"}
        ]
      },
      "RELEASE_CANDIDATE": {
        "action_kind": "LOCAL_SCRIPT",
        "handler": "stage:freeze",
        "validator": "validate:freeze",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "FROZEN",
        "checkpoints": ["freeze"],
        "artifacts": [
          {"name": "visual-review-record", "path": "{source_root}/publication/v2/visual-review-v2.json"},
          {"name": "freeze-record", "path": "{source_root}/publication/v2/freeze-record-v2.json"},
          {"name": "release-manifest", "path": "{source_root}/publication/v2/release-manifest-v2.json"}
        ]
      },
      "FROZEN": {
        "action_kind": "WORKFLOW_DISPATCH",
        "handler": "stage:release",
        "validator": "validate:release",
        "validator_version": "2.0-rc1",
        "handoff_required": true,
        "next_state": "RELEASED",
        "checkpoints": ["release"],
        "retry_policy": {"retryable": false, "max_attempts": 1},
        "idempotency": {"mode": "ACTION_ID", "key": null},
        "artifacts": [
          {"name": "merge-verification", "path": "{source_root}/publication/v2/merge-verification-v2.json"},
          {"name": "release-record", "path": "{source_root}/publication/v2/release-record-v2.json"}
        ]
      }
    }
  },
  "state_authority": {
    "authoritative_filename": "production-state.json",
    "profile_filename": "production-profile.json",
    "legacy_filename": "pipeline-state.json",
    "legacy_mode": "NON_AUTHORITATIVE_READ_ONLY",
    "checkpoint_attestation_dir": "orchestration/v2/attestations",
    "architecture_approval_path": "gates/architecture-approval.json",
    "publication_preview_approval_path": "gates/publication-preview-approval.json"
  }
}

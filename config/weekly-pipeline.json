{
  "schema_version": "1.0",
  "editorial": {
    "cutoff_timezone": "America/New_York",
    "cutoff_weekday": "FRIDAY",
    "cutoff_hour": 18,
    "cutoff_minute": 0,
    "compilation_timezone": "Asia/Tokyo",
    "scheduled_plan_cron_utc": "30 0 * * 6"
  },
  "intake": {
    "canonical_window_days": 7,
    "front_segment_days": 4,
    "default_segment": "full"
  },
  "policy": {
    "unattended_public_release": false,
    "human_gate_required_for_selection": true,
    "human_gate_required_for_freeze": true,
    "raw_collector_output_is_immutable": true,
    "frozen_revision_is_immutable": true
  },
  "lifecycle_states": [
    "ISSUE_INITIALIZED",
    "DISCOVERY_COLLECTED",
    "CANDIDATES_NORMALIZED",
    "EVIDENCE_REVIEWED",
    "SELECTION_COMPLETE",
    "ARCHITECTURE_ESTABLISHED",
    "DRAFT_COMPLETE",
    "VALIDATED_DRAFT",
    "RELEASE_CANDIDATE",
    "FROZEN"
  ],
  "validation_targets": [
    "selection",
    "draft",
    "release-candidate",
    "frozen"
  ]
}

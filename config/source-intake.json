      { "id": "nvidia-generative-ai-blog", "url": "https://blogs.nvidia.com/blog/tag/generative-ai/" },
      { "id": "ai2-blog", "url": "https://allenai.org/blog" },
      { "id": "apple-ml-research", "url": "https://machinelearning.apple.com/research" },
      { "id": "ibm-ai-announcements", "url": "https://www.ibm.com/new/announcements" },
      { "id": "runway-news", "url": "https://runwayml.com/news" },

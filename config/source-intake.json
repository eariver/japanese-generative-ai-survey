{
  "schema_version": "1.0",
  "user_agent": "japanese-generative-ai-survey/0.1 (+https://github.com/eariver/japanese-generative-ai-survey)",
  "http_timeout_seconds": 45,
  "arxiv": {
    "enabled": true,
    "endpoint": "https://export.arxiv.org/api/query",
    "delay_seconds": 20,
    "request_timeout_seconds": 120,
    "max_attempts": 3,
    "retry_backoff_seconds": 20,
    "max_results_per_query": 200,
    "queries": [
      { "id": "cs-ai", "search_query": "cat:cs.AI" },
      { "id": "cs-cl", "search_query": "cat:cs.CL" },
      { "id": "cs-lg", "search_query": "cat:cs.LG" },
      { "id": "cs-cv", "search_query": "cat:cs.CV" },
      { "id": "cs-dc", "search_query": "cat:cs.DC" },
      { "id": "cs-cr", "search_query": "cat:cs.CR" }
    ]
  },
  "github_releases": {
    "enabled": true,
    "api_version": "2026-03-10",
    "per_page": 100,
    "repositories": [
      "sgl-project/sglang",
      "vllm-project/vllm",
      "ggml-org/llama.cpp",
      "huggingface/transformers",
      "NVIDIA/TensorRT-LLM",
      "flashinfer-ai/flashinfer",
      "Comfy-Org/ComfyUI"
    ]
  },
  "official_pages": {
    "enabled": true,
    "pages": [
      { "id": "openai-news-rss", "url": "https://openai.com/news/rss.xml" },
      { "id": "anthropic-news", "url": "https://www.anthropic.com/news" },
      { "id": "google-deepmind-blog", "url": "https://deepmind.google/blog/" },
      { "id": "google-gemini-api-release-notes", "url": "https://ai.google.dev/gemini-api/docs/changelog" },
      { "id": "mistral-news", "url": "https://mistral.ai/news/" },
      { "id": "alibaba-model-studio-model-lifecycle", "url": "https://www.alibabacloud.com/help/en/model-studio/newly-released-models" },
      { "id": "deepseek-api-updates", "url": "https://api-docs.deepseek.com/updates/" },
      { "id": "kimi-code-whats-new", "url": "https://www.kimi.com/code/docs/en/kimi-code/whats-new.html" },
      { "id": "minimax-news", "url": "https://www.minimax.io/news" },
      { "id": "zai-release-notes", "url": "https://docs.z.ai/release-notes/new-released" }
    ]
  }
}

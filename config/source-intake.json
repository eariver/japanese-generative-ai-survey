{
  "schema_version": "1.0",
  "user_agent": "japanese-generative-ai-survey/0.1 (+https://github.com/eariver/japanese-generative-ai-survey)",
  "http_timeout_seconds": 45,
  "coverage_policy": {
    "base_intake_role": "BROAD_SEED_NOT_EXHAUSTIVE",
    "retrospective_period_requires_coverage_audit": true,
    "supplemental_primary_source_gap_fill_required_when_material_gaps_found": true,
    "curated_reconstruction_may_replace_base_intake": false,
    "architecture_may_claim_source_intake_complete_without_coverage_audit": false,
    "long_window_partition_threshold_days": 45
  },
  "arxiv": {
    "enabled": true,
    "endpoint": "https://export.arxiv.org/api/query",
    "delay_seconds": 20,
    "request_timeout_seconds": 120,
    "max_attempts": 3,
    "retry_backoff_seconds": 20,
    "max_results_per_query": 2000,
    "queries": [
      { "id": "cs-ai", "search_query": "cat:cs.AI" },
      { "id": "cs-cl", "search_query": "cat:cs.CL" },
      { "id": "cs-lg", "search_query": "cat:cs.LG" },
      { "id": "cs-cv", "search_query": "cat:cs.CV" },
      { "id": "cs-dc", "search_query": "cat:cs.DC" },
      { "id": "cs-cr", "search_query": "cat:cs.CR" }
    ]
  },
  "github_releases": {
    "enabled": true,
    "api_version": "2026-03-10",
    "per_page": 100,
    "repositories": [
      "sgl-project/sglang",
      "vllm-project/vllm",
      "ggml-org/llama.cpp",
      "huggingface/transformers",
      "NVIDIA/TensorRT-LLM",
      "flashinfer-ai/flashinfer",
      "Comfy-Org/ComfyUI"
    ]
  },
  "official_pages": {
    "enabled": true,
    "pages": [
      { "id": "openai-news-rss", "url": "https://openai.com/news/rss.xml" },
      { "id": "anthropic-news", "url": "https://www.anthropic.com/news" },
      { "id": "google-deepmind-blog", "url": "https://deepmind.google/blog/" },
      { "id": "google-gemini-api-release-notes", "url": "https://ai.google.dev/gemini-api/docs/changelog" },
      { "id": "meta-ai-blog", "url": "https://ai.meta.com/blog/" },
      { "id": "mistral-news", "url": "https://mistral.ai/news/" },
      { "id": "qwen-blog", "url": "https://qwenlm.github.io/blog/" },
      { "id": "alibaba-model-studio-model-lifecycle", "url": "https://www.alibabacloud.com/help/en/model-studio/newly-released-models" },
      { "id": "deepseek-api-updates", "url": "https://api-docs.deepseek.com/updates/" },
      { "id": "xai-news", "url": "https://x.ai/news" },
      { "id": "stability-ai-news", "url": "https://stability.ai/news-updates" },
      { "id": "cohere-blog", "url": "https://cohere.com/blog" },
      { "id": "microsoft-azure-ai-blog", "url": "https://azure.microsoft.com/en-us/blog/category/ai-machine-learning/" },
